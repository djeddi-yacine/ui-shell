#!/usr/bin/env bash
# Verify the single clean seed, deterministic generation, and staging contract.
set -euo pipefail
project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
default=$project/default
reader=$project/scripts/read-ini
generator=$project/tools/scripts/generate-default
stager=$project/tools/scripts/stage-defaults
fail() { printf 'Defaults: %s\n' "$*" >&2; exit 1; }
scratch=$(mktemp -d "${XDG_CACHE_HOME:-${TMPDIR:-/tmp}}/defaults.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

expect_seed() {
  local directory=$1
  mapfile -t entries < <(find "$directory" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort)
  [[ ${entries[*]-} == 'default.png profile.ini theme.ini' ]] ||
    fail "$directory must contain only default.png, profile.ini and theme.ini"
  for name in default.png theme.ini profile.ini; do
    [[ -f $directory/$name && ! -L $directory/$name ]] ||
      fail "$directory/$name must be a regular file"
  done
}

# The checked-in seed is exactly the default wallpaper, theme and profile.
expect_seed "$default"
[[ $(stat -c '%a' "$default/theme.ini") == 644 && $(stat -c '%a' "$default/profile.ini") == 644 ]] ||
  fail 'generated default INI files must be mode 0644'
jq -e '.wallpaper_folders.default == "default"' <<<"$("$reader" "$project/tools/manifest.ini")" >/dev/null ||
  fail 'manifest.ini must map the default folder ID to default/'
lua - "$project/hypr/default/monitors.lua" <<'LUA'
local policy = dofile(arg[1])
assert(type(policy.overrides) == "table" and next(policy.overrides) == nil,
  "the shipped monitor policy must not contain host-specific overrides")
LUA

# Staging refreshes runtime code and the default seed. User Lua lives outside
# the staged tree, so staging never creates or reads a hypr/user directory.
stage=$scratch/stage
bash "$project/tools/scripts/stage-config" "$project" "$stage" >/dev/null
printf 'stale\n' >"$stage/hypr/appearance.lua"
printf 'stale\n' >"$stage/default/.stale"
bash "$project/tools/scripts/stage-config" "$project" "$stage" >/dev/null
[[ ! -e $stage/hypr/user ]] || fail 'staging created a hypr/user directory'
cmp -- "$project/hypr/appearance.lua" "$stage/hypr/appearance.lua" ||
  fail 'restaging did not refresh runtime Hyprland files'
expect_seed "$stage/default"

# A fresh generation from the same wallpaper is byte-for-byte identical.
mkdir -p "$scratch/generate"
ln -s -- "$project/scripts" "$scratch/generate/scripts"
cp -a -- "$default" "$scratch/generate/default"
bash "$generator" "$scratch/generate/default" >/dev/null
expect_seed "$scratch/generate/default"
for name in default.png theme.ini profile.ini; do
  cmp -- "$default/$name" "$scratch/generate/default/$name" ||
    fail "generated default/$name differs from the checked-in seed"
done

# Staging installs the clean seed and seeds runtime stores only when absent.
install=$scratch/install
bash "$stager" "$project" "$install"
expect_seed "$install/default"
for name in default.png theme.ini profile.ini; do
  cmp -- "$default/$name" "$install/default/$name" || fail "staged default/$name differs"
done
cmp -- "$default/theme.ini" "$install/themes/default/config.ini" || fail 'default theme store was not seeded'
cmp -- "$default/profile.ini" "$install/profiles/default/profile.ini" || fail 'default profile store was not seeded'

# The profile snapshots, palette key and file theme describe one coherent seed.
state=$("$project/scripts/read-theme-profile" "$install/profiles/default/profile.ini" "$install" \
  "$install/profiles" "$install/themes" "$reader")
theme=$("$reader" "$install/themes/default/config.ini" | jq -c '.palette.schema |= tonumber')
image_sha=$(sha256sum -- "$default/default.png")
image_sha=${image_sha%% *}
mode=$(jq -er '.palette.mode' <<<"$theme")
[[ $mode == dark || $mode == light ]] || fail 'theme mode must be dark or light'
expected_key="$image_sha-$mode-v2"
jq -e --arg install "$install" --arg key "$expected_key" --argjson theme "$theme" '
  .theme.id == "default" and .theme.source == "file" and
  .theme.definition == ($install + "/themes/default/config.ini") and
  .theme.definitionOverrides == {} and
  .wallpaper.color_mode == $theme.palette.mode and
  .wallpaper.default == {folder:"default", path:"default.png", fit_mode:"cover", palette_key:$key} and
  .wallpaper.monitors == {} and
  .profileColors.byOutput == {} and
  (.profileColors.defaultPalette ==
    ($theme.palette + {colors:$theme.colors, hyprland:$theme.hyprland}))
' <<<"$state" >/dev/null || fail 'profile and theme snapshots are inconsistent'

# The active recipe path is constrained to Profiles, even though a Theme
# definition also lives under the same installation root.
mkdir -p -- "$scratch/home"
cp -- "$project/tools/manifest.ini" "$install/manifest.ini"
cp -- "$project/tools/settings.ini" "$install/settings.ini"
sed 's|profile = profiles/default/profile.ini|profile = themes/default/config.ini|' \
  "$install/settings.ini" >"$install/.cross-store.ini"
if env HOME="$scratch/home" XDG_CONFIG_HOME="$scratch/home/.config" \
    XDG_CACHE_HOME="$scratch/home/.cache" XDG_DATA_HOME="$scratch/home/.local/share" \
    XDG_STATE_HOME="$scratch/home/.local/state" \
    "$project/scripts/read-shell-config" "$install/manifest.ini" "$install/.cross-store.ini" "$reader" \
    >"$scratch/cross-store.json" 2>/dev/null; then
  fail 'settings accepted a Theme definition as its active Profile'
fi
[[ ! -s $scratch/cross-store.json ]] || fail 'invalid cross-store settings emitted partial data'

# Every staging replaces default/ cleanly but never rewrites user stores.
printf 'stale\n' >"$install/default/.stale"
printf 'changed\n' >"$install/default/theme.ini"
printf 'user theme\n' >"$install/themes/default/config.ini"
printf 'user profile\n' >"$install/profiles/default/profile.ini"
bash "$stager" "$project" "$install"
expect_seed "$install/default"
cmp -- "$default/theme.ini" "$install/default/theme.ini" || fail 'staging did not restore the clean default theme'
[[ $(<"$install/themes/default/config.ini") == 'user theme' ]] || fail 'staging rewrote a user theme'
[[ $(<"$install/profiles/default/profile.ini") == 'user profile' ]] || fail 'staging rewrote a user profile'

# Missing runtime store files are reseeded; existing store directories remain.
rm -- "$install/themes/default/config.ini" "$install/profiles/default/profile.ini"
bash "$stager" "$project" "$install"
cmp -- "$default/theme.ini" "$install/themes/default/config.ini" || fail 'missing default theme was not seeded'
cmp -- "$default/profile.ini" "$install/profiles/default/profile.ini" || fail 'missing default profile was not seeded'

# An unclean source seed is rejected before it can touch a destination.
mkdir -p "$scratch/unclean"
cp -a -- "$default" "$scratch/unclean/default"
printf 'extra\n' >"$scratch/unclean/default/extra"
if bash "$stager" "$scratch/unclean" "$scratch/unclean-install" >/dev/null 2>&1; then
  fail 'staging accepted an unclean source seed'
fi
[[ ! -e $scratch/unclean-install ]] || fail 'rejected source seed touched the destination'

printf '%s\n' 'Defaults passed: one clean seed, deterministic generation, coherent snapshots, clean replacement and absent-only store seeding.'
