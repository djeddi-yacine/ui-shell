#!/usr/bin/env bash
# Scoped writes are exercised only by the private test runtime.
set -euo pipefail
tmp=$(mktemp -d /tmp/ui-shell-component-settings.XXXXXX)
trap 'rm -rf -- "$tmp"' EXIT
export XDG_CONFIG_HOME="$tmp/config" HOME="$tmp/home"
mkdir -p "$HOME"
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
rejects() { if "$@" >/dev/null 2>&1; then fail "expected rejection: $*"; fi; }

runtime_source=${UI_SHELL_RUNTIME:?resolved runtime data required}
runtime="$tmp/runtime.json"
jq --arg components "$XDG_CONFIG_HOME/ui-shell/components" '.paths.components = $components' "$runtime_source" >"$runtime"
export UI_SHELL_RUNTIME=$runtime
command_path() { jq -er --arg role "$1" '.commands[$role]' "$UI_SHELL_RUNTIME"; }
render_launcher=$(command_path renderLauncherSettings)
render_picker=$(command_path renderPickerSettings)
settings_path=$(command_path componentSettingsPath)
read_settings=$(command_path readComponentSettings)
save_settings=$(command_path saveComponentSettings)

for args in 'true 1' 'false 24' 'undefined undefined'; do
  # Intentional word splitting on these fixed test vectors.
  read -r a b <<<"$args"
  "$render_launcher" "$a" "$b" | grep -q '^QtObject {' || fail 'launcher renderer shape'
done
rejects "$render_launcher" nope 1
rejects "$render_launcher" true 0
rejects "$render_launcher" true 25
rejects "$render_launcher" true 1 extra
for args in '1 1' '6 4' 'undefined undefined'; do
  read -r a b <<<"$args"
  "$render_picker" "$a" "$b" | grep -q '^QtObject {' || fail 'picker renderer shape'
done
rejects "$render_picker" 0 1
rejects "$render_picker" 7 1
rejects "$render_picker" 1 5
rejects "$render_picker" nope 1
rejects "$settings_path" alien default ''
rejects "$settings_path" launcher output ''
rejects "$settings_path" launcher default MONITOR

mapfile -t read_result < <("$read_settings" launcher default '')
default_path=${read_result[0]} default_rev=${read_result[1]}
[[ $default_rev == absent && ! -e $default_path ]] || fail 'missing read mutated storage'
[[ $default_path == "$XDG_CONFIG_HOME/ui-shell/components/launcher/Default.qml" ]] || fail 'default path'
expected_hash=$(printf '%s' HDMI-A-1 | sha256sum); expected_hash=${expected_hash%% *}
[[ $("$settings_path" wallpaper output HDMI-A-1) == "$XDG_CONFIG_HOME/ui-shell/components/wallpaper/outputs/$expected_hash.qml" ]] || fail 'output hash is not exact UTF-8 SHA-256'
linebreak_path="$tmp/has"$'\n'"newline"
for invalid_components in relative '' "$linebreak_path" "$tmp/../escape"; do
  invalid_runtime="$tmp/invalid-runtime.json"
  jq --arg components "$invalid_components" '.paths.components = $components' "$runtime" >"$invalid_runtime"
  rejects env UI_SHELL_RUNTIME="$invalid_runtime" "$settings_path" launcher default ''
done

rev=$("$save_settings" launcher default '' absent true 12)
[[ $rev =~ ^[[:xdigit:]]{64}$ ]] || fail 'save did not return digest'
[[ $(stat -c %a "$default_path") == 600 ]] || fail 'mode is not 600'
mapfile -t read_result < <("$read_settings" launcher default '')
reload_path=${read_result[0]} reload_rev=${read_result[1]}
[[ $reload_path == "$default_path" && $reload_rev == "$rev" ]] || fail 'save/reload mismatch'
grep -qx 'import QtQuick' "$default_path" || fail 'missing import'
grep -qx '    property var showIcons: true' "$default_path" || fail 'missing launcher override'
grep -qx '    property var visibleRows: 12' "$default_path" || fail 'missing launcher rows'
grep -q '"' "$default_path" && fail 'settings file is not QML'

before=$(sha256sum "$default_path")
rejects "$save_settings" launcher default '' absent false 13
[[ $(sha256sum "$default_path") == "$before" ]] || fail 'stale write changed file'

# Both racers share the same initial revision; exactly one must commit.
set +e
("$save_settings" launcher default '' "$rev" false 10 >"$tmp/a.out" 2>"$tmp/a.err") & p1=$!
("$save_settings" launcher default '' "$rev" true 20 >"$tmp/b.out" 2>"$tmp/b.err") & p2=$!
wait "$p1"; s1=$?
wait "$p2"; s2=$?
set -e
(( (s1 == 0 && s2 != 0) || (s2 == 0 && s1 != 0) )) || fail 'CAS concurrency did not elect exactly one writer'

for output in HDMI-A-1 DP-2; do
  p=$("$settings_path" wallpaper output "$output")
  [[ $p == "$XDG_CONFIG_HOME/ui-shell/components/wallpaper/outputs/"*.qml ]] || fail 'output path shape'
  r=$("$save_settings" wallpaper output "$output" absent 2 3)
  [[ $r =~ ^[[:xdigit:]]{64}$ ]] || fail 'picker save digest'
done
p1=$("$settings_path" wallpaper output HDMI-A-1)
p2=$("$settings_path" wallpaper output DP-2)
[[ $p1 != "$p2" && -f $p1 && -f $p2 ]] || fail 'output scopes not independent'
default_picker=$("$settings_path" wallpaper default '')
[[ ! -e $default_picker ]] || fail 'default/output file collision'

# Reset is represented by undefined values and remains a loadable QtObject.
"$save_settings" wallpaper default '' absent undefined undefined >/dev/null
grep -qx '    property var wideColumns: undefined' "$default_picker" || fail 'undefined reset missing'
grep -qx '    property var maximumVisibleRows: undefined' "$default_picker" || fail 'undefined rows reset missing'
grep -qx 'QtObject {' "$default_picker" || fail 'renderer is not a QtObject'

# Reject symlinked component ancestry without touching the target.
mkdir -p "$tmp/outside"
ln -s "$tmp/outside" "$XDG_CONFIG_HOME/ui-shell/components/wallpaper/outputs-link" 2>/dev/null || true
rm -rf -- "$XDG_CONFIG_HOME/ui-shell/components/launcher"
ln -s "$tmp/outside" "$XDG_CONFIG_HOME/ui-shell/components/launcher"
rejects "$settings_path" launcher default ''
rejects "$save_settings" launcher default '' absent true 4
[[ -z $(find "$tmp/outside" -mindepth 1 -print -quit) ]] || fail 'symlink target was modified'

# Distinct first writes concurrently create a wholly missing configuration tree.
fresh="$tmp/fresh-config"
jq --arg components "$fresh/ui-shell/components" '.paths.components = $components' "$runtime" >"$tmp/fresh-runtime.json"
set +e
(env UI_SHELL_RUNTIME="$tmp/fresh-runtime.json" "$save_settings" launcher default '' absent true 8 >"$tmp/fresh-default.out" 2>"$tmp/fresh-default.err") & p1=$!
(env UI_SHELL_RUNTIME="$tmp/fresh-runtime.json" "$save_settings" wallpaper output HDMI-A-2 absent 3 2 >"$tmp/fresh-one.out" 2>"$tmp/fresh-one.err") & p2=$!
(env UI_SHELL_RUNTIME="$tmp/fresh-runtime.json" "$save_settings" wallpaper output DP-3 absent 4 1 >"$tmp/fresh-two.out" 2>"$tmp/fresh-two.err") & p3=$!
wait "$p1"; s1=$?
wait "$p2"; s2=$?
wait "$p3"; s3=$?
set -e
(( s1 == 0 && s2 == 0 && s3 == 0 )) || fail 'fresh-tree concurrent saves failed'
for path in \
  "$fresh/ui-shell/components/launcher/Default.qml" \
  "$fresh/ui-shell/components/wallpaper/outputs/$(printf '%s' HDMI-A-2 | sha256sum | cut -d' ' -f1).qml" \
  "$fresh/ui-shell/components/wallpaper/outputs/$(printf '%s' DP-3 | sha256sum | cut -d' ' -f1).qml"; do
  [[ -s $path && $(stat -c %a "$path") == 600 ]] || fail 'fresh-tree settings file missing or not private'
  grep -q '^QtObject {' "$path" || fail 'fresh-tree settings file incomplete'
  [[ -e $path.lock && $(stat -c %a "$path.lock") == 600 ]] || fail 'fresh-tree lock missing or not private'
done
for dir in "$fresh/ui-shell/components" "$fresh/ui-shell/components/launcher" "$fresh/ui-shell/components/wallpaper" "$fresh/ui-shell/components/wallpaper/outputs"; do
  [[ $(stat -c %a "$dir") == 700 ]] || fail "settings directory is not private: $dir"
done

# Audio settings: the third component, declared in shell/config/ComponentSpec.qml.
render_audio=$(command_path renderAudioSettings)
for args in '1 100' '5 125' 'undefined 150' '10 undefined' 'undefined undefined'; do
  read -r a b <<<"$args"
  "$render_audio" "$a" "$b" | grep -q '^QtObject {' || fail 'audio renderer shape'
done
rejects "$render_audio" maybe 100
rejects "$render_audio" 3 100
rejects "$render_audio" 11 100
rejects "$render_audio" 1 99
rejects "$render_audio" 1 151
rejects "$render_audio" 1 100 extra
[[ $("$settings_path" audio default '') == "$XDG_CONFIG_HOME/ui-shell/components/audio/Default.qml" ]] || fail 'audio default path'
audio_rev=$("$save_settings" audio default '' absent 5 125)
[[ $audio_rev =~ ^[[:xdigit:]]{64}$ ]] || fail 'audio save did not return a digest'
audio_path=$("$settings_path" audio default '')
grep -q 'property var volumeStep: 5' "$audio_path" && grep -q 'property var maximumVolume: 125' "$audio_path" || fail 'audio values not persisted'
rejects "$save_settings" audio default '' "$audio_rev" 3 130
rejects "$save_settings" audio default '' absent 1 100
output_rev=$("$save_settings" audio output HDMI-A-1 absent 2 undefined)
[[ $output_rev =~ ^[[:xdigit:]]{64}$ ]] || fail 'audio output override did not save'
# The spec table and the renderer must agree on the choices the editor offers.
for step in 1 2 5 10; do "$render_audio" "$step" undefined >/dev/null || fail "spec step $step is not renderable"; done
for volume in 100 125 150; do "$render_audio" undefined "$volume" >/dev/null || fail "spec choice $volume is not renderable"; done
grep -q 'choices: \[1, 2, 5, 10\]' /project/shell/config/ComponentSpec.qml && grep -q 'choices: \[100, 125, 150\]' /project/shell/config/ComponentSpec.qml || fail 'ComponentSpec audio choices changed without the renderer'

# Recording and screenshot settings: the fourth and fifth components.
render_record=$(command_path renderRecordSettings)
render_shot=$(command_path renderShotSettings)
for args in '0 true false 60 high auto opus auto mp4 true false' '3 false true 24 very_high h264 aac 2500 mkv false true' '5 undefined undefined 144 ultra vp9 undefined 80000 mkv undefined undefined' 'undefined true undefined undefined undefined undefined undefined undefined undefined undefined undefined' '10 undefined true 30 medium hevc aac 12000 mp4 true false'; do
  read -r a b c d e f g h i j k <<<"$args"
  "$render_record" "$a" "$b" "$c" "$d" "$e" "$f" "$g" "$h" "$i" "$j" "$k" | grep -q '^QtObject {' || fail 'record renderer shape'
done
"$render_record" 5 true true 60 very_high auto aac 5000 mkv false true | grep -q 'property var quality: "very_high"' || fail 'record renderer must quote strings'
rejects "$render_record" 4 true false 60 high auto opus auto mp4 true false
rejects "$render_record" 3 maybe false 60 high auto opus auto mp4 true false
rejects "$render_record" 3 true false 61 high auto opus auto mp4 true false
rejects "$render_record" 3 true false 60 best auto opus auto mp4 true false
rejects "$render_record" 3 true false 60 high vp8 opus auto mp4 true false
rejects "$render_record" 3 true false 60 high auto opus auto avi true false
rejects "$render_record" 3 true false 60 high auto flac auto mp4 true false
rejects "$render_record" 3 true false 60 high auto mp3 auto mp4 true false
rejects "$render_record" 3 true false 60 high auto opus 1234 mp4 true false
rejects "$render_record" 3 true false 60 high auto opus auto mp4 maybe false
rejects "$render_record" 3 true false 60 high auto opus auto mp4 true false extra
rejects "$render_record" 3 true
for args in 'true true' 'true false' 'false true' 'undefined undefined'; do
  read -r a b <<<"$args"
  "$render_shot" "$a" "$b" | grep -q '^QtObject {' || fail 'shot renderer shape'
done
rejects "$render_shot" false false
rejects "$render_shot" yes true
[[ $("$settings_path" record default '') == "$XDG_CONFIG_HOME/ui-shell/components/record/Default.qml" ]] || fail 'record default path'
[[ $("$settings_path" shot default '') == "$XDG_CONFIG_HOME/ui-shell/components/shot/Default.qml" ]] || fail 'shot default path'
record_rev=$("$save_settings" record default '' absent 5 true true 30 ultra hevc aac 8000 mkv false true)
[[ $record_rev =~ ^[[:xdigit:]]{64}$ ]] || fail 'record save did not return a digest'
record_path=$("$settings_path" record default '')
grep -q 'property var countdown: 5' "$record_path" && grep -q 'property var microphone: true' "$record_path" && grep -q 'property var webcam: true' "$record_path" && grep -q 'property var fps: 30' "$record_path" && grep -q 'property var codec: "hevc"' "$record_path" && grep -q 'property var audioCodec: "aac"' "$record_path" && grep -q 'property var bitrate: "8000"' "$record_path" && grep -q 'property var cursor: false' "$record_path" || fail 'record values not persisted'
rejects "$save_settings" record default '' "$record_rev" 4 true false 60 high auto opus auto mp4 true false
rejects "$save_settings" record default '' absent 3 true false 60 high auto opus auto mp4 true false
shot_rev=$("$save_settings" shot default '' absent true false)
[[ $shot_rev =~ ^[[:xdigit:]]{64}$ ]] || fail 'shot save did not return a digest'

# The record spec and its renderer must agree on every choice the popup offers.
for q in medium high very_high ultra; do "$render_record" undefined undefined undefined undefined "$q" undefined undefined undefined undefined undefined undefined >/dev/null || fail "spec quality $q is not renderable"; done
for c in auto h264 hevc av1 vp9; do "$render_record" undefined undefined undefined undefined undefined "$c" undefined undefined undefined undefined undefined >/dev/null || fail "spec codec $c is not renderable"; done
for b in auto 2500 5000 8000 12000 20000 40000 80000; do "$render_record" undefined undefined undefined undefined undefined undefined undefined "$b" undefined undefined undefined >/dev/null || fail "spec bitrate $b is not renderable"; done
for a in opus aac; do "$render_record" undefined undefined undefined undefined undefined undefined "$a" undefined undefined undefined undefined >/dev/null || fail "spec audio codec $a is not renderable"; done
grep -q 'choices: \["opus", "aac"\]' /project/shell/config/ComponentSpec.qml || fail 'ComponentSpec audio codec choices changed without the renderer'
for f in 24 30 60 90 120 144; do "$render_record" undefined undefined undefined "$f" undefined undefined undefined undefined undefined undefined undefined >/dev/null || fail "spec fps $f is not renderable"; done
grep -q 'choices: \[24, 30, 60, 90, 120, 144\]' /project/shell/config/ComponentSpec.qml && grep -q 'choices: \["medium", "high", "very_high", "ultra"\]' /project/shell/config/ComponentSpec.qml && grep -q 'choices: \["auto", "h264", "hevc", "av1", "vp9"\]' /project/shell/config/ComponentSpec.qml || fail 'ComponentSpec record choices changed without the renderer'

# Control tuning: the renderer owns the model; the committed seed must equal its defaults.
render_tuning=$(command_path renderControlTuning)
"$render_tuning" | cmp -s - /project/shell/theme/GeneratedControlTuning.qml \
  || fail 'shell/theme/GeneratedControlTuning.qml is stale; run scripts/render-control-tuning'
"$render_tuning" hoverLayer=0.12 containerShift=0.2 | grep -q '"hoverLayer":0.12' || fail 'tuning override not applied'
rejects "$render_tuning" nope=1
rejects "$render_tuning" hoverLayer=9
rejects "$render_tuning" hoverLayer=abc
rejects "$render_tuning" hoverLayer
rejects "$settings_path" controls output HDMI-A-1
[[ $("$settings_path" controls default '') == "$XDG_CONFIG_HOME/ui-shell/components/controls/Default.qml" ]] || fail 'tuning path'
tuning_rev=$("$save_settings" controls default '' absent hoverLayer=0.12 textContrast=5)
[[ $tuning_rev =~ ^[[:xdigit:]]{64}$ ]] || fail 'tuning save did not return digest'
tuning_path=$("$settings_path" controls default '')
grep -q '"hoverLayer":0.12' "$tuning_path" && grep -q '"textContrast":5' "$tuning_path" || fail 'tuning values not persisted'
[[ $(stat -c %a "$tuning_path") == 600 ]] || fail 'tuning file is not private'
rejects "$save_settings" controls default '' absent hoverLayer=0.12
rejects "$save_settings" controls default '' "$tuning_rev" nope=1
"$save_settings" controls default '' "$tuning_rev" >/dev/null || fail 'reset to defaults failed'
grep -q '"hoverLayer":0.08' "$tuning_path" || fail 'reset did not restore defaults'

# The model is data: a new mode and a new emphasis need JSON only, and bad data is rejected.
model_copy="$tmp/model-copy"
mkdir -p "$model_copy"
cp -a "$(dirname "$render_tuning")/control-model" "$(dirname "$render_tuning")/render-control-tuning" "$model_copy/"
jq '. + [{"key":"demo","label":"Demo","description":"Test-only mode.","values":{"hoverLayer":0.2},
  "behavior":{"flags":{"hover":"none"},"emphasis":{"danger":{"family":"solid","rest":"primary"}}}}]' \
  "$model_copy/control-model/modes.json" >"$model_copy/modes.new" && mv "$model_copy/modes.new" "$model_copy/control-model/modes.json"
"$model_copy/render-control-tuning" mode=demo | grep -q '"key": "demo"' || fail 'a new mode needs more than JSON'
"$model_copy/render-control-tuning" mode=demo | grep -q '"danger"' || fail 'a new emphasis needs more than JSON'
"$model_copy/render-control-tuning" mode=demo | grep -q '"hoverLayer":0.2' || fail 'new mode preset not applied'
jq '.[1].behavior = {"families":{"outline":{"states":{"select":{"fill":"nope","fg":"text","border":"rest"}}}}}' \
  "$model_copy/control-model/modes.json" >"$model_copy/modes.bad"
cp "$model_copy/modes.bad" "$model_copy/control-model/modes.json"
rejects "$model_copy/render-control-tuning"

printf '%s\n' 'Component settings checks passed.'
