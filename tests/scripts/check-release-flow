#!/usr/bin/env bash
# tools/scripts/release end to end in a scratch repository: a throwaway signing key, a local bare
# remote, the real dev-update sandbox. Covers the bump, the signed tag, the install and the
# previous-to-new upgrade proofs, the push, the refusals, and the undo when a proof fails.
# The real repository, keys and remote are never touched. Needs bwrap and gpg.
# Setup: tests/scripts/release-fixture.
set -euo pipefail
# shellcheck source=tests/scripts/release-fixture
source "$(dirname -- "${BASH_SOURCE[0]}")/release-fixture"

# Refusals change nothing.
head_before=$(git -C "$repo" rev-parse HEAD)
printf 'dirty\n' >>"$repo/VERSION"
! release patch --no-gate --yes || fail 'a dirty tree was released'
rg -q 'not clean' "$scratch/out" || fail 'the dirty-tree refusal has no reason'
git -C "$repo" checkout -q -- VERSION
! release sideways --yes || fail 'an unknown bump was accepted'
release patch --plan || fail "--plan failed: $(<"$scratch/out")"
rg -q 'v0.1.0 -> v0.1.1' "$scratch/out" || fail '--plan did not name the next version'
[[ $(git -C "$repo" rev-parse HEAD) == "$head_before" && -z $(git -C "$repo" tag -l v0.1.1) ]] || fail 'a refusal or --plan changed the repository'

# A patch release: tag signed, proofs run, pushed.
release patch --no-gate --no-public --yes || { cat -- "$scratch/out" >&2; fail 'the patch release failed'; }
[[ $(git -C "$scratch/remote.git" show main:VERSION) == 0.1.1 ]] || fail 'the remote main lacks VERSION 0.1.1'
GNUPGHOME=$scratch/gpg git -C "$scratch/remote.git" verify-tag v0.1.1 >/dev/null 2>&1 || fail 'the pushed tag does not verify'
[[ $(git -C "$scratch/remote.git" log -1 --format=%s v0.1.1) == 'Release v0.1.1' ]] || fail 'the tag is not on the release commit'
rg -q 'proof 2: v0.1.0 updates to v0.1.1' "$scratch/out" && rg -q 'rollback exit 0' "$scratch/out" || fail 'the upgrade and rollback proof did not run'
release patch --plan || fail "--plan with nothing new failed: $(<"$scratch/out")"
rg -q 'only bumps VERSION' "$scratch/out" || fail 'a release with no new commits is not announced'

# No default key home, and a key that is not the pinned one is refused before anything changes.
git -C "$repo" commit -q --allow-empty -m 'Another change'
head_before=$(git -C "$repo" rev-parse HEAD)
(cd -- "$repo" && env -u RELEASE_GNUPGHOME bash tools/scripts/release minor --plan) >"$scratch/out" 2>&1 && fail 'a release without RELEASE_GNUPGHOME was planned'
rg -q 'set RELEASE_GNUPGHOME' "$scratch/out" || fail 'the missing-home refusal has no reason'
signer_key=$scratch/other.asc
! release minor --plan || fail 'a signing key that is not the pinned one was accepted'
rg -q 'pins' "$scratch/out" || fail 'the key-mismatch refusal has no reason'
signer_key=$scratch/signer.asc
(cd -- "$repo" && RELEASE_GNUPGHOME=$scratch/gpg RELEASE_SIGNING_KEY=$signer_fp RELEASE_SIGNER_KEY=$signer_key bash tools/scripts/release minor --plan) >"$scratch/out" 2>&1 && fail 'a stub primary key was accepted as the signing key'
rg -q 'not a usable signing key' "$scratch/out" || fail 'the stub-key refusal has no reason'
# Without --yes the key is shown and a "no" changes nothing.
! (cd -- "$repo" && RELEASE_GNUPGHOME=$scratch/gpg RELEASE_SIGNER_KEY=$signer_key bash tools/scripts/release minor --no-gate </dev/null) >"$scratch/out" 2>&1 || fail 'signing went ahead without confirmation'
rg -q "signing key $subkey_fp" "$scratch/out" || fail 'the signing key was not shown'
[[ $(git -C "$repo" rev-parse HEAD) == "$head_before" ]] || fail 'a declined confirmation changed the repository'

# A failing proof is undone and never pushed: a symlink in a release part is refused by the build.
ln -s /etc/passwd "$repo/shell/badlink"
git -C "$repo" add -f shell/badlink
git -C "$repo" commit -q -m 'A tree the release build refuses'
head_before=$(git -C "$repo" rev-parse HEAD)
! release minor --no-gate --no-public --yes || fail 'a release that cannot be installed was made'
[[ $(git -C "$repo" rev-parse HEAD) == "$head_before" ]] || fail 'the failed release commit was not removed'
[[ -z $(git -C "$repo" tag -l v0.2.0) && -z $(git -C "$scratch/remote.git" tag -l v0.2.0) ]] || fail 'the failed release left a tag'
[[ $(git -C "$scratch/remote.git" show main:VERSION) == 0.1.1 ]] || fail 'the failed release reached the remote'
printf '%s\n' 'Release flow checks passed.'
