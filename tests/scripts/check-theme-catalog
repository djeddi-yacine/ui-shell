#!/usr/bin/env python3
"""Prove large catalogs use metadata only and selected records still validate."""
import json
import os
import pathlib
import runpy
import subprocess
import tempfile
import time
from unittest import mock


project = pathlib.Path(__file__).resolve().parent.parent.parent
discover = runpy.run_path(str(project / "scripts/theme-catalog"))["catalog"]
with tempfile.TemporaryDirectory(prefix="theme-catalog-") as temporary:
    root = pathlib.Path(temporary)
    themes = root / "colors collection"
    themes.mkdir()
    profiles = root / "saved profiles"
    profiles.mkdir(parents=True)
    shipped_themes, shipped_profiles = root / "shipped themes", root / "shipped profiles"
    for identity in ("theme-17", "shipped-only"):
        (shipped_themes / identity).mkdir(parents=True)
        (shipped_themes / identity / "config.ini").write_text("x\n")
        (shipped_profiles / identity).mkdir(parents=True)
        (shipped_profiles / identity / "profile.ini").write_text("x\n")
    runtime = {"paths": {"themes": str(themes), "profiles": str(profiles),
                         "shippedThemes": str(shipped_themes), "shippedProfiles": str(shipped_profiles)},
               "theme": {"profile": ""}}
    size = 500
    for number in range(size):
        identity = f"theme-{number}"
        record = profiles / identity / "profile.ini"
        record.parent.mkdir()
        # Intentionally invalid/unreadable: discovering this choice must not parse it.
        record.write_text("Not a valid Theme record.\n")
        record.chmod(0)
        palette = themes / identity / "config.ini"
        palette.parent.mkdir(parents=True)
        palette.write_text("Not a valid palette.\n")
        palette.chmod(0)
    (profiles / "linked-profile").symlink_to(profiles / "theme-17", target_is_directory=True)
    linked_record = profiles / "linked-file" / "profile.ini"
    linked_record.parent.mkdir()
    linked_record.symlink_to(profiles / "theme-17" / "profile.ini")
    (profiles / "linked-theme").symlink_to(profiles / "theme-17", target_is_directory=True)
    (themes / "linked-colors").symlink_to(themes / "theme-17", target_is_directory=True)
    runtime["theme"]["profile"] = str(profiles / "theme-17" / "profile.ini")
    started = time.perf_counter()
    with mock.patch("builtins.open", side_effect=AssertionError("Catalog opened an asset")), \
            mock.patch("pathlib.Path.open", side_effect=AssertionError("Catalog opened an asset")), \
            mock.patch("subprocess.run", side_effect=AssertionError("Catalog ran a validator")):
        result = discover(runtime)
    elapsed = time.perf_counter() - started
    # The shipped store adds only ids the user store lacks; a user entry with the same id wins.
    assert len(result["profiles"]) == size + 1 and len(result["palettes"]) == size + 1
    assert next(entry for entry in result["palettes"] if entry["id"] == "theme-17")["path"] == str(themes / "theme-17" / "config.ini")
    assert next(entry for entry in result["palettes"] if entry["id"] == "shipped-only")["path"] == str(shipped_themes / "shipped-only" / "config.ini")
    assert all(set(entry) == {"id", "label", "path"} for entry in result["profiles"] + result["palettes"])
    assert next(entry for entry in result["profiles"] if entry["id"] == "theme-17")["path"] == str(profiles / "theme-17" / "profile.ini")
    assert all(entry["id"] not in {"linked-profile", "linked-theme"} for entry in result["profiles"])
    assert all(entry["id"] not in {"linked-file", "linked-colors"} for entry in result["palettes"] + result["profiles"])
    selected = next(entry for entry in result["profiles"] if entry["id"] == "theme-21")
    selected_path = pathlib.Path(selected["path"])
    selected_path.chmod(0o600)
    rejection = subprocess.run([str(project / "scripts/read-theme-profile"), selected["path"],
                                str(root), str(profiles), str(themes), str(project / "scripts/read-ini")],
                               capture_output=True, text=True)
    assert rejection.returncode != 0 and rejection.stderr
    manifest = root / "runtime.json"
    manifest.write_text(json.dumps(runtime))
    output = subprocess.run([str(project / "scripts/theme-catalog"), str(manifest)], capture_output=True, text=True, check=True)
    assert json.loads(output.stdout) == result
    # A missing shipped store is tolerated; a missing user store is an error.
    gone = dict(runtime["paths"], shippedThemes=str(root / "absent"), shippedProfiles=str(root / "absent"))
    assert len(discover(dict(runtime, paths=gone))["profiles"]) == size
    for store in ("profiles", "themes"):
        broken = dict(runtime, paths=dict(runtime["paths"], **{store: str(root / "no such store")}))
        try:
            discover(broken)
        except FileNotFoundError:
            pass
        else:
            raise AssertionError(f"a missing user {store} store was tolerated")
    print(f"Theme catalog passed: {size} direct metadata-only entries in {elapsed:.3f}s, stable IDs, symlink rejection, no asset reads or validators; invalid selection rejected.")
