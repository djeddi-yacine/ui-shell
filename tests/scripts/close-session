#!/usr/bin/env bash
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
source "$project_root/tests/nested.conf"
prefix=${1:?Run prefix required}
[[ $prefix =~ ^${test_process_prefix}-[a-zA-Z0-9]+$ ]] || { printf '%s\n' 'Invalid test run prefix.' >&2; exit 2; }
[[ $test_shutdown_signal == TERM || $test_shutdown_signal == KILL ]] || { printf '%s\n' 'Test shutdown signal must be TERM or KILL.' >&2; exit 2; }

terminate() {
  local signal=$1 pid
  while IFS= read -r pid; do
    [[ $pid != "$$" && $pid != "$PPID" ]] || continue
    kill -"$signal" "$pid" 2>/dev/null || true
  done < <(pgrep --env "UI_SHELL_TEST_PREFIX=$prefix" || true)
}
terminate "$test_shutdown_signal"
if [[ $test_shutdown_signal == TERM ]]; then
  deadline=$((SECONDS + test_cleanup_seconds))
  while pgrep --env "UI_SHELL_TEST_PREFIX=$prefix" >/dev/null && (( SECONDS < deadline )); do
    sleep "$test_poll_seconds"
  done
fi
terminate KILL
printf 'Closed sandbox processes with prefix: %s\n' "$prefix"
