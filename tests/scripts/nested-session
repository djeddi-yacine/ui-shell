#!/usr/bin/env bash
set -euo pipefail

mode=${1:?run or check mode required}
source /source/tests/nested.conf
for part in "${test_copied_project_parts[@]}"; do
  cp -a -- "/source/$part" "$test_project/$part"
done
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"
bash "$test_project/tools/scripts/stage-config" "$test_project" "$test_config_root"
# The clipboard panel reads the package's own cliphist store; seed its config in the private home.
bash "$test_project/update/seed-cliphist-config" "$test_project" "$XDG_CONFIG_HOME"
# uuctl asks through the shell's menu in this private home.
bash "$test_project/update/seed-menu-entry" "$test_project" "$test_config_root/scripts/menu" "$XDG_DATA_HOME"
if [[ -n ${UI_SHELL_TEST_MANAGER_BUS-} ]]; then
  mkdir -p "$test_runtime/app2unit-bin"
  ln -s "$test_project/$test_app_runner" "$test_runtime/app2unit-bin/systemd-run"
  chmod +x "$test_project/$test_app_runner"
  # The shell runs the real `app2unit` from PATH; this session's PATH reaches a stand-in that hands the
  # launch to the session-owned manager. Production QML and configuration are untouched.
  mkdir -p "$test_runtime/launcher-bin"
  ln -s "$test_project/$test_app_runner" "$test_runtime/launcher-bin/app2unit"
  export PATH="$test_runtime/launcher-bin:$PATH"
fi
# The Phantomat library is an optional user setting; the plugin test mounts it, so opt in once.
if [[ ${UI_SHELL_TEST_PHANTOMAT-} == 1 ]] && ! rg -q '^\[phantomat\]$' "$test_config_root/settings.ini"; then
  printf '\n[phantomat]\nlibrary = plugins/spatialoverview.so\n' >>"$test_config_root/settings.ini"
fi
resolved=$(mktemp "$XDG_CACHE_HOME/.ui-shell-paths.XXXXXX")
bash "$test_config_root/scripts/read-shell-config" "$test_config_root/manifest.ini" "$test_config_root/settings.ini" "$test_config_root/scripts/read-ini" >"$resolved"
export UI_SHELL_RUNTIME
if [[ $mode == import-themes ]]; then
  # Definitions only: no profile compilation or native bootstrap writes.
  trap 'rm -f -- "$resolved"' EXIT
  bash "$test_project/tools/scripts/import-reference-themes" "$resolved" "/source/$test_theme_reference" \
    "$test_theme_positive" "$test_theme_warning" "$test_theme_negative"
  exit 0
fi
if [[ $mode == theme ]]; then
  [[ $test_theme_sample =~ ^[a-z0-9-]+/(dark|day|high-contrast|day-high-contrast|oled)$ ]] || { printf '%s\n' 'Invalid test theme sample.' >&2; exit 2; }
  UI_SHELL_RUNTIME=$resolved
  "$(jq -er '.commands.normalizeThemeColors' "$resolved")" \
    "/source/$test_theme_reference/$test_theme_sample/colors.toml" "$XDG_CACHE_HOME/test-theme.json" \
    "$test_theme_positive" "$test_theme_warning" "$test_theme_negative"
  jq -n --slurpfile colors "$XDG_CACHE_HOME/test-theme.json" \
    '{source:"file",definition:"",definitionOverrides:{},defaultPalette:($colors|first),byOutput:{}}' >"$XDG_CACHE_HOME/test-policy.json"
  jq '.wallpaper' "$resolved" >"$XDG_CACHE_HOME/test-wallpaper.json"
  revision=$("$(jq -er '.commands.readThemeState' "$resolved")" "$resolved" | jq -er '.revision')
  recipe=$("$(jq -er '.commands.publishThemeBundle' "$resolved")" "$resolved" default "$XDG_CACHE_HOME/test-policy.json" "$XDG_CACHE_HOME/test-wallpaper.json")
  "$(jq -er '.commands.selectThemeProfile' "$resolved")" persist "$recipe" "$revision" ''
  rm -f -- "$recipe"
  bash "$test_config_root/scripts/read-shell-config" "$test_config_root/manifest.ini" "$test_config_root/settings.ini" "$test_config_root/scripts/read-ini" >"$resolved"
fi
UI_SHELL_RUNTIME=$(bash "$test_config_root/scripts/prepare-runtime" "$resolved")
export UI_SHELL_RUNTIME_LUA
UI_SHELL_RUNTIME_LUA=$(jq -r '.runtimeLua' "$UI_SHELL_RUNTIME")
rm -f -- "$resolved"
# Existing source-relative unit imports test the generated tree Quickshell loads, not a second copy.
mv -- "$test_project/shell" "$test_project/source-shell"
ln -s -- "$(jq -er '.paths.quickshell' "$UI_SHELL_RUNTIME")" "$test_project/shell"
# Tests that stage or copy the shipped QML again read it from here, never from the generated tree.
export UI_SHELL_STAGE_SHELL=$test_project/source-shell

case $mode in
  run|smoke|snapshot|theme|profiles|motion|launcher|notifications|apps|app-launch|app-close|phantomat|borders) exec dbus-run-session --config-file="$test_project/$test_dbus_config" -- bash "$test_project/tests/scripts/run-session" "$mode" ;;
  check) exec dbus-run-session --config-file="$test_project/$test_dbus_config" -- bash "$test_project/tests/scripts/check-sandbox" ;;
  qml) exec dbus-run-session --config-file="$test_project/$test_dbus_config" -- bash "$test_project/tests/scripts/check-qml" ;;
  theme-config) exec dbus-run-session --config-file="$test_project/$test_dbus_config" -- bash "$test_project/tests/scripts/check-theme-config" ;;
  pipelines) exec dbus-run-session --config-file="$test_project/$test_dbus_config" -- bash "$test_project/tests/scripts/check-pipelines" ;;
  *) printf '%s\n' 'Mode must be run, smoke, snapshot, theme, import-themes, profiles, motion, launcher, notifications, apps, app-launch, app-close, phantomat, borders, check, qml, theme-config or pipelines.' >&2; exit 1 ;;
esac
