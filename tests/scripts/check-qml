#!/usr/bin/env bash
set -euo pipefail

source /project/tests/nested.conf
shell_directory=$(jq -er '.paths.quickshell' "$UI_SHELL_RUNTIME")
bash "$test_project/tests/scripts/generate-theme-test-fixtures"
mapfile -t qml_files < <(rg --files "$shell_directory" -g '*.qml')
"$test_qmllint" "${qml_files[@]}"

mkdir -p /artifacts/build/tests/reports/junit /artifacts/build/tests/gallery
# Keep these components independent of sibling Quickshell singletons while
# preserving their real source and relative imports.
mkdir -p "$shell_directory/tests/wallpaper" "$shell_directory/tests/apps" "$shell_directory/tests/auth" "$shell_directory/tests/mpris"
cp "$shell_directory/adapters/PolkitAuth.qml" "$shell_directory/tests/auth/PolkitAuth.qml"
# The media card and its selection run without Quickshell; relative imports stay valid at this depth.
cp "$shell_directory/adapters/MediaSelection.qml" "$shell_directory/tests/mpris/MediaSelection.qml"
cp "$shell_directory/adapters/MediaArt.qml" "$shell_directory/tests/mpris/MediaArt.qml"
cp "$shell_directory/modules/mpris/MprisCard.qml" "$shell_directory/tests/mpris/MprisCard.qml"
cp "$shell_directory/modules/mpris/MprisArtBackdrop.qml" "$shell_directory/tests/mpris/MprisArtBackdrop.qml"
cp "$shell_directory/modules/mpris/MprisArtLayer.qml" "$shell_directory/tests/mpris/MprisArtLayer.qml"
cp "$shell_directory/modules/mpris/MarqueeText.qml" "$shell_directory/tests/mpris/MarqueeText.qml"
cp "$shell_directory/modules/wallpaper/WallpaperTile.qml" "$shell_directory/tests/wallpaper/WallpaperTile.qml"
cp "$shell_directory/modules/apps/AppSearch.qml" "$shell_directory/tests/apps/AppSearch.qml"

for qml_test in \
  tst_ControlColors tst_ControlTuning tst_ControlState tst_ShellButton tst_ShellComboOption \
  tst_ShellComboBox tst_WallpaperTile tst_ShellTextField tst_PaletteColorField \
  tst_PaletteColorPicker tst_ThemeEditor tst_OutputPalette tst_AppSearch \
  tst_LauncherOutput tst_ContextPopup tst_ErrorPopup tst_StateGallery tst_ModeGallery tst_PatchLogic tst_ShellSlider tst_ContextHelp tst_ExitDialog tst_TargetPicker tst_PointerTracker tst_SecretDialog tst_PolkitAuth tst_MediaSelection tst_MprisCard tst_MarqueeText tst_MediaArt tst_MprisSpec tst_MprisArtBackdrop tst_PanelGroup tst_NotifCenter tst_NotifRules tst_NotifMarkup tst_NotifCard; do
  test_report=/artifacts/build/tests/reports/junit/qmltests-$qml_test-$(date -u +%Y-%m-%d-%H%M%S).xml
  QT_QPA_PLATFORM=offscreen "$test_qmltestrunner" \
    -input "$test_project/tests/$qml_test.qml" \
    -o -,txt -o "$test_report",junitxml
  printf 'QML test report: %s\n' "$test_report"
done

launcher_policy="$shell_directory/config/GeneratedLauncherOutput.qml"
for launcher_mode in output-name screen-index; do
  if [[ $launcher_mode == output-name ]]; then launcher_target=__TEST_OUTPUT_B__; else launcher_target=1; fi
  bash "$test_project/scripts/render-shell-launcher-output" "$launcher_policy" "$launcher_mode" "$launcher_target"
  QT_QPA_PLATFORM=offscreen "$test_qmltestrunner" -input "$test_project/tests/tst_LauncherOutput.qml" -o -,txt
done
shader_dir="$test_project/shell/modules/notifications/shaders"
[[ $(cat "$shader_dir/spoiler.frag.sha256") == $(sha256sum "$shader_dir/spoiler.frag" | cut -d" " -f1) ]] \
  || { echo 'spoiler.frag changed: run make dev-shaders (needs qt6-shadertools)' >&2; exit 1; }
policy_before=$(sha256sum "$launcher_policy")
if bash "$test_project/scripts/render-shell-launcher-output" "$launcher_policy" screen-index -1; then
  printf '%s\n' 'Invalid launcher output policy was accepted.' >&2
  exit 1
fi
[[ $(sha256sum "$launcher_policy") == "$policy_before" ]]
printf '%s\n' 'QML lint, component suites and launcher output tests passed.'
