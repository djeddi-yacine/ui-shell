#!/usr/bin/env bash
# Runs inside the live nested session: answers real menu requests with the keyboard (Hyprland's
# send_shortcut reaches the card) and checks that after the last answer nothing is left behind:
# no request directory, no answer pipe, no helper process, no mapped window.
# A stand-in client is used, never uuctl, whose last step changes systemd units.
# Prints one `ok`/`FAIL` line per check; exits 1 on any failure.
set -u
client=/source/scripts/menu
spool=$XDG_RUNTIME_DIR/ui-shell/menu
fail=0
check() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (expected '$2', got '$3')"; fail=1; fi; }
wait_for() { local i; for i in $(seq 100); do eval "$1" && return 0; sleep 0.1; done; return 1; }
instances=$(hyprctl -j instances)
export HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY
HYPRLAND_INSTANCE_SIGNATURE=$(jq -er 'if length == 1 then .[0].instance else empty end' <<<"$instances")
WAYLAND_DISPLAY=$(jq -er '.[0].wl_socket' <<<"$instances")
requests() { find "$spool" -mindepth 1 -maxdepth 1 -not -name '.*' 2>/dev/null | wc -l; }
mapped() { hyprctl layers | grep -c 'namespace: ui-shell-menu'; }
key() { timeout 10 hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"\", key = \"$1\" })" >/dev/null 2>&1; }
helpers() { pgrep -f "$client|tail --pid|cat > .*/result" | grep -vc "^$$\$" ; }
wait_for '[ -s "$spool/.shell" ]'

# Two requests in a row, the way uuctl asks; the first is answered with Enter, the second with Escape.
{
  first=$(printf 'alpha\nbeta\n' | "$client" -p "One: " --app closer); echo "first=$first" > /artifacts/close.out
  printf 'gamma\ndelta\n' | "$client" -p "Two: " --app closer > /artifacts/close-second.out; echo "second-exit=$?" >> /artifacts/close.out
} &
runner=$!
wait_for '[ "$(requests)" -ge 1 ]'; sleep 1.5
key Return
wait_for 'grep -q "^first=" /artifacts/close.out 2>/dev/null'
check "Enter answers with the first line" "first=alpha" "$(grep '^first=' /artifacts/close.out 2>/dev/null)"
wait_for '[ "$(requests)" -ge 1 ]'; sleep 1.5
key Escape
wait "$runner"
check "Escape ends the second request with no choice" "second-exit=1" "$(grep '^second-exit=' /artifacts/close.out)"
check "nothing was printed for it" 0 "$(wc -c < /artifacts/close-second.out)"

for i in $(seq 50); do [ "$(mapped)" -eq 0 ] && break; sleep 0.1; done
check "no request directory or pipe is left in the spool" 0 "$(requests)"
check "the card and the scrim are unmapped" 0 "$(mapped)"
for i in $(seq 30); do [ "$(helpers)" -eq 0 ] && break; sleep 0.1; done
check "no client, watcher or answer writer process is left" 0 "$(helpers)"
check "the spool holds only .shell" ".shell" "$(ls -A "$spool")"
exit $fail
