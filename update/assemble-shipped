#!/usr/bin/env bash
# Build the read-only second search root of a release: shipped/themes/<id>/config.ini (the bundled
# reference Themes plus default/theme.ini as `default`) and shipped/profiles/default/profile.ini.
# Readers fall back to it when the user's stores lack an id; the updater never writes user config.
set -euo pipefail
(( $# == 2 )) || { printf '%s\n' 'Usage: assemble-shipped SOURCE_ROOT DESTINATION' >&2; exit 2; }
source_root=$(realpath -e -- "$1")
destination=$(realpath -m -- "$2")
[[ -f $source_root/default/theme.ini && -f $source_root/default/profile.ini && -d $source_root/bundled-themes ]] || {
  printf 'Assemble shipped: %s lacks default/ or bundled-themes/.\n' "$source_root" >&2; exit 1;
}
[[ ! -e $destination ]] || { printf 'Assemble shipped: %s exists.\n' "$destination" >&2; exit 1; }
mkdir -p -- "$destination/themes/default" "$destination/profiles/default"
cp --no-preserve=timestamps,ownership -- "$source_root/default/theme.ini" "$destination/themes/default/config.ini"
cp --no-preserve=timestamps,ownership -- "$source_root/default/profile.ini" "$destination/profiles/default/profile.ini"
while IFS= read -r -d '' bundled; do
  id=${bundled%/config.ini}; id=${id##*/}
  [[ $id != default ]] || { printf '%s\n' 'Assemble shipped: a bundled Theme may not be named default.' >&2; exit 1; }
  mkdir -p -- "$destination/themes/$id"
  cp --no-preserve=timestamps,ownership -- "$bundled" "$destination/themes/$id/config.ini"
done < <(find "$source_root/bundled-themes" -mindepth 2 -maxdepth 2 -name config.ini -print0)
