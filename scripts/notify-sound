#!/usr/bin/env bash
# Play one notification sound through pw-play.
# Usage: notify-sound ABSOLUTE_FILE | SOUND_NAME   (a freedesktop sound-naming-spec name, e.g. message-new-instant)
# Exit: 0 played or skipped by the 500 ms cooldown; 2 bad argument or unknown sound name; 3 pw-play missing.
set -euo pipefail

file=${1-}
if [[ $# == 1 && $file =~ ^[A-Za-z0-9._-]+$ ]]; then
  # A themeable name: look it up in the sound themes of the data directories.
  name=$file file=
  IFS=: read -ra roots <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for root in "${roots[@]}"; do
    for candidate in "$root"/sounds/*/stereo/"$name".{oga,ogg,wav}; do
      [[ -r $candidate ]] && { file=$candidate; break 2; }
    done
  done
  [[ -n $file ]] || { printf '%s\n' "notify-sound: no sound named $name" >&2; exit 2; }
fi
[[ $# == 1 && $file == /* && -f $file && -r $file ]] || { printf '%s\n' 'notify-sound: need one readable absolute file or a sound name' >&2; exit 2; }
case $file in
  *.wav | *.ogg | *.oga) ;;
  *) printf '%s\n' 'notify-sound: only .wav, .ogg and .oga files' >&2; exit 2 ;;
esac
command -v pw-play >/dev/null 2>&1 || { printf '%s\n' 'notify-sound: pw-play not found' >&2; exit 3; }

stamp=${XDG_RUNTIME_DIR:-/tmp}/ui-shell-notify-sound.stamp
now=$(date +%s%3N)
if [[ -f $stamp ]]; then
  last=$(<"$stamp")
  [[ $last =~ ^[0-9]+$ ]] || last=0
  (( now - last >= 500 )) || exit 0
fi
printf '%s\n' "$now" >"$stamp"
exec pw-play -- "$file"
