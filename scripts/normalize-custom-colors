#!/usr/bin/env bash
set -euo pipefail
if (( $# != 3 )); then
  printf '%s\n' 'Usage: normalize-custom-colors INPUT_INI OUTPUT_JSON INI_READER' >&2
  exit 2
fi
input=$1 output=$2 reader=$3
normalized=$("$reader" "$input" | jq -S -ce '
  def complete_colors:
    . as $colors | ["accent","selection","muted","background","dark_background","darker_background","lighter_background","foreground","dark_foreground","light_foreground","bright_foreground","red","yellow","orange","green","cyan","blue","magenta","brown","bright_red","bright_yellow","bright_green","bright_cyan","bright_blue","bright_magenta"] | all(.[]; . as $key | $colors | has($key));
  def valid_border:
    split(" ") as $parts |
    ($parts[-1] | test("^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)deg$")) as $angled |
    (if $angled then $parts[:-1] else $parts end) as $stops |
    ($stops | length) > 0 and all($stops[]; test("^(rgb\\([0-9A-Fa-f]{6}\\)|rgba\\([0-9A-Fa-f]{8}\\))$")) and (($angled | not) or ($stops | length) > 1);
  ["background","surface","surfaceVariant","elevated","text","textMuted",
   "accent","positive","warning","negative","outline","focus","scrim"] as $roles |
  if type != "object" or (keys | sort) != ["colors","hyprland","palette"] then error("schema 2 requires exactly [palette], [colors], and [hyprland]") else . end |
  .palette as $palette | .colors as $colors | .hyprland as $hyprland |
  if ($palette | type != "object" or (keys | sort) != (($roles + ["schema","mode"]) | sort)) then error("invalid palette fields")
  elif $palette.schema != "2" then error("schema must be exactly 2")
  elif ($palette.mode != "dark" and $palette.mode != "light") then error("mode must be dark or light")
  elif ([$roles[] as $role | $palette[$role]] | all(type == "string" and test("^#[0-9A-Fa-f]{6}$")) | not) then error("invalid palette color")
  elif ($colors | complete_colors | not) then error("missing named palette slots")
  elif ($colors | type != "object" or length == 0 or
        (to_entries | all(.[]; (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | type == "string" and test("^#[0-9A-Fa-f]{6}$"))) | not)) then error("invalid named palette colors")
  elif ($hyprland | type != "object" or (keys | sort) != ["active_border","inactive_border"]) then error("invalid Hyprland fields")
  elif ([$hyprland.active_border, $hyprland.inactive_border] | all(type == "string" and valid_border) | not) then error("invalid Hyprland border expression")
  else {schema: 2, mode: $palette.mode} + ($palette | with_entries(select(.key as $key | $roles | index($key)))) + {colors: $colors, hyprland: $hyprland}
  end
')
temporary=$(mktemp "$(dirname -- "$output")/.$(basename -- "$output").XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
printf '%s\n' "$normalized" >"$temporary"
mv -f -- "$temporary" "$output"
