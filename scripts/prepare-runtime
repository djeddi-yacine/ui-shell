#!/usr/bin/env bash
# Compile the selected recipe, then build the generated Quickshell tree in the cache: links into
# the release's shell/ with the generated files beside them. Nothing is written into the release.
set -euo pipefail
[[ $# == 1 ]] || { printf '%s\n' 'Usage: prepare-runtime RESOLVED_JSON' >&2; exit 2; }
input=$1
jq -e '.schema == 1' "$input" >/dev/null
while IFS= read -r executable; do
  [[ -x $executable ]] || { printf 'Configured command is not executable: %s\n' "$executable" >&2; exit 1; }
done < <(jq -r '.commands[], .profileRenderers[]' "$input")
runtime_file=$(jq -er '.runtimeFile' "$input")
runtime_lua=$(jq -er '.runtimeLua' "$input")
runtime_qml=$(jq -er '.bootstrap.runtime' "$input")
catalog=$(jq -er '.bootstrap.wallpaperCatalog' "$input")
module=$(jq -er '.bootstrap.profileModule' "$input")
shell=$(jq -er '.paths.shell' "$input")
tree=$(jq -er '.paths.quickshell' "$input")
release_root=$(jq -er '.releaseRoot' "$input")
config_directory=$tree/config
# The generated tree is the runtime directory; every generated file lives inside its config/.
[[ $tree == "$(jq -er '.paths.runtime' "$input")" && $runtime_qml == "$config_directory/GeneratedRuntime.qml" &&
   $catalog == "$config_directory/GeneratedWallpapers.qml" && $module == "$config_directory/ProfileBundle" ]] || {
  printf '%s\n' 'Bootstrap files must be GeneratedRuntime.qml, GeneratedWallpapers.qml and ProfileBundle in config/ of the runtime directory.' >&2; exit 1;
}
[[ -d $shell && -f $shell/shell.qml && -f $shell/config/qmldir ]] || { printf 'Release shell tree is incomplete: %s\n' "$shell" >&2; exit 1; }
[[ -f $release_root/RELEASE && $(wc -l <"$release_root/RELEASE") == 1 && -s $release_root/RELEASE ]] || {
  printf 'The release needs a one-line RELEASE file: %s\n' "$release_root/RELEASE" >&2; exit 1;
}
mkdir -p -- "$config_directory" "${runtime_file%/*}" "${runtime_lua%/*}"

# Point `destination` at `target`; replace only a link, never a real file.
link_into() {
  local target=$1 destination=$2 stage
  [[ ! -e $destination && ! -L $destination || -L $destination ]] || {
    printf 'Not an owned link: %s\n' "$destination" >&2; return 1;
  }
  [[ -L $destination && $(readlink -- "$destination") == "$target" ]] && return 0
  stage=$(mktemp -u "${destination}.XXXXXX")
  ln -s -- "$target" "$stage"
  mv -Tf -- "$stage" "$destination"
}
# Mirror `source_directory` into `directory`: one link per entry (documents and the qmldir
# excluded; the top level also skips config/, which is a real directory), stale links removed.
mirror() {
  local source_directory=$1 directory=$2 entry name link
  shift 2
  for entry in "$source_directory"/*; do
    name=${entry##*/}
    [[ $name == *.md || $name == qmldir || $name == config && $source_directory == "$shell" ]] && continue
    link_into "$entry" "$directory/$name"
  done
  for link in "$directory"/*; do
    name=${link##*/}
    [[ -L $link && $name != ProfileBundle && ! -e $source_directory/$name ]] && rm -f -- "$link"
  done
  return 0
}
mirror "$shell" "$tree"
mirror "$shell/config" "$config_directory"

work=$(mktemp -d)
temporary='' link_stage=''
trap 'rm -rf -- "$work"; if [[ -n $temporary ]]; then rm -f -- "$temporary"; fi; if [[ -n $link_stage ]]; then rm -f -- "$link_stage/module"; rmdir -- "$link_stage"; fi' EXIT
"$(jq -er '.commands.readThemeProfile' "$input")" "$(jq -er '.theme.profile' "$input")" "$(jq -er '.configRoot' "$input")" \
  "$(jq -er '.paths.profiles' "$input")" "$(jq -er '.paths.themes' "$input")" "$(jq -er '.commands.readIni' "$input")" \
  "$(jq -er '.paths.shippedProfiles' "$input")" "$(jq -er '.paths.shippedThemes' "$input")" >"$work/profile.json"
jq --slurpfile profile "$work/profile.json" '. + ($profile|first) | del(.bundle)' "$input" >"$work/resolved.json"
"$(jq -er '.commands.compileThemeProfile' "$input")" "$work/resolved.json" >"$work/bundle.json"
jq --slurpfile bundle "$work/bundle.json" '.bundle=($bundle|first)' "$work/resolved.json" >"$work/runtime.json"
"$(jq -er '.commands.renderWallpaperCatalog' "$input")" "$work/runtime.json" "$work/catalog.qml"
[[ ! -e $module || -L $module ]] || { printf '%s\n' 'Bootstrap profile module must be an owned link inside the generated tree.' >&2; exit 1; }
# Quickshell blackholes relative imports escaping its root. A native module link
# keeps resolution inside that root without copying compiled files into config.
link_stage=$(mktemp -d "${module%/*}/.profile-link.XXXXXX")
ln -s -- "$(jq -er '.quickshell' "$work/bundle.json")" "$link_stage/module"
mv -Tf -- "$link_stage/module" "$module"
rmdir -- "$link_stage"
link_stage=''
# The release qmldir declares only shipped types; the generated singletons are added here.
cat -- "$shell/config/qmldir" >"$work/qmldir"
printf '%s\n' 'singleton GeneratedLauncherOutput 1.0 GeneratedLauncherOutput.qml' \
  'singleton GeneratedWallpapers 1.0 GeneratedWallpapers.qml' \
  'singleton GeneratedRuntime 1.0 GeneratedRuntime.qml' >>"$work/qmldir"
# The launcher output override is a user choice written by render-shell-launcher-output:
# create the neutral default once and keep an existing one.
if [[ ! -e $config_directory/GeneratedLauncherOutput.qml ]]; then
  printf '%s\n' 'pragma Singleton' 'import QtQuick' '' 'QtObject {' \
    '    // Optional generated override; undefined retains the explicit user default.' \
    '    readonly property var targetMode: undefined' \
    '    readonly property var screenIndex: undefined' \
    '    readonly property var outputName: undefined' '}' >"$work/launcher.qml"
  mv -f -- "$work/launcher.qml" "$config_directory/GeneratedLauncherOutput.qml"
fi
temporary=$(mktemp "${runtime_file}.XXXXXX")
cp -- "$work/runtime.json" "$temporary"
"$(jq -er '.commands.renderRuntime' "$input")" "$temporary" "$runtime_qml" "$runtime_lua"
mv -f -- "$work/qmldir" "$config_directory/qmldir"
mv -f -- "$work/catalog.qml" "$catalog"
mv -f -- "$temporary" "$runtime_file"
temporary=''
# The stamp is written last: an interrupted run leaves a stale stamp, which forces regeneration.
cat -- "$release_root/RELEASE" >"$work/RELEASE"
mv -f -- "$work/RELEASE" "$tree/RELEASE"
printf '%s\n' "$runtime_file"
