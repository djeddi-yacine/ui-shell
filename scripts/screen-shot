#!/usr/bin/env bash
# Screenshot backend for the shell: grim for the picture, wl-copy for the clipboard. It has no
# state and starts nothing that outlives it.
#
#   screen-shot capabilities
#   screen-shot capture monitor:NAME | window:ADDRESS | region:WxH+X+Y
#                       [--copy yes|no] [--save yes|no] [--delay MILLISECONDS] [--output FILE]
#       prints one JSON object: {file, size, copied}; at least one of copy and save must be yes.
#   screen-shot capture TARGET --buffer yes [--delay MILLISECONDS]
#       takes the picture now and keeps it as the buffer; prints {buffer, size}.
#   screen-shot commit [--copy yes|no] [--save yes|no] [--output FILE]
#       delivers the buffer like a capture would, then drops it.
#
# A window is captured through its own toplevel handle (grim -T, the compositor's foreign-toplevel
# capture), so it is the window's own pixels whichever workspace it is on and whatever covers it;
# no portal is involved. A region is the rectangle `slurp` selected.
set -euo pipefail

temporary=
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
fail() { printf 'screen-shot: %s\n' "$*" >&2; exit 1; }
# The user's XDG directory: the environment variable if set, else `xdg-user-dir`, else the XDG
# default under $HOME.
user_dir() { # XDG_NAME and the plain directory name under $HOME, e.g. user_dir VIDEOS Videos
  local variable="XDG_${1}_DIR" value
  value=${!variable-}
  [[ -n $value ]] || value=$(xdg-user-dir "$1" 2>/dev/null || true)
  [[ -n $value && $value != "$HOME" ]] || value=$HOME/$2
  printf '%s' "$value"
}

buffer_file=${UI_SHELL_SHOT_BUFFER:-${XDG_RUNTIME_DIR:-/tmp}/ui-shell/shot-buffer.png}

# The foreign-toplevel handle of a window (Hyprland's stableId), which grim -T captures.
window_handle() {
  local address=$1 handle
  [[ $address =~ ^0x[0-9a-f]{1,16}$ ]] || fail 'window address must look like 0x55d0c0a1b2c0'
  command -v hyprctl >/dev/null || fail 'hyprctl is required to capture a window'
  handle=$(timeout 5 hyprctl -j clients 2>/dev/null | jq -r --arg a "$address" '.[] | select(.address == $a and .mapped) | .stableId // empty') || true
  [[ $handle =~ ^[0-9a-f]+$ ]] || fail 'that window is gone; choose another target'
  printf '%s' "$handle"
}

# The shell hides its panel before asking for a picture, but the compositor keeps drawing a hidden
# layer while it fades out (the host's own animation settings, not ours). Wait until the panel
# layer has left `hyprctl layers`, then for as long as the layer-out animations last (read from
# the compositor: speed x 100 ms, each leaf falling back to its parent when not overridden).
wait_for_layers_gone() {
  command -v hyprctl >/dev/null || return 0
  local tries milliseconds
  for tries in $(seq 20); do
    timeout 2 hyprctl -j layers 2>/dev/null | jq -e '[.. | objects | select(.namespace? == "ui-shell-shot") ] | length == 0' >/dev/null && break
    sleep 0.05
  done
  milliseconds=$(timeout 2 hyprctl -j animations 2>/dev/null | jq -r '
    (flatten | map({key: .name, value: .}) | from_entries) as $a
    | def speed($name; $parent): ($a[$name] // {}) as $leaf
        | if ($leaf.overridden // false) then (if $leaf.enabled then $leaf.speed else 0 end)
          else ($a[$parent] // {}) | (if (.enabled // true) then (.speed // 0) else 0 end) end;
    ([speed("layersOut"; "layers"), speed("fadeLayersOut"; "fadeLayers"), speed("fadeLayers"; "fade")] | max) * 100 | ceil' 2>/dev/null) || milliseconds=0
  [[ $milliseconds =~ ^[0-9]+$ ]] || milliseconds=0
  (( milliseconds == 0 )) || sleep "$(awk -v ms="$((milliseconds + 100))" 'BEGIN { printf "%.3f", ms / 1000 }')"
}

valid_region() { [[ ${1-} =~ ^[1-9][0-9]{0,4}x[1-9][0-9]{0,4}\+[0-9]{1,6}\+[0-9]{1,6}$ ]]; }

capabilities() {
  local have=false copy=false
  command -v grim >/dev/null && have=true
  command -v wl-copy >/dev/null && copy=true
  jq -cn --argjson have "$have" --argjson copy "$copy" '{available: $have, clipboard: $copy, targets: ["monitor", "window", "region"]}'
}

capture() {
  local target=${1-} copy=yes save=yes delay=0 output= buffer=no
  [[ -n $target ]] || fail 'a target is required'
  shift
  while (( $# )); do
    case $1 in
      --copy) copy=${2-}; shift 2 ;;
      --save) save=${2-}; shift 2 ;;
      --delay) delay=${2-}; shift 2 ;;
      --output) output=${2-}; shift 2 ;;
      --buffer) buffer=${2-}; shift 2 ;;
      *) fail "unknown option: $1" ;;
    esac
  done
  [[ $buffer == yes ]] && { copy=no; save=no; }
  [[ $copy == yes || $copy == no ]] || fail '--copy takes yes or no'
  [[ $save == yes || $save == no ]] || fail '--save takes yes or no'
  [[ $buffer == yes || $copy == yes || $save == yes ]] || fail 'a screenshot needs a destination: copy or save'
  [[ $delay =~ ^[0-9]{1,4}$ ]] || fail '--delay takes 0 to 9999 milliseconds'
  command -v grim >/dev/null || fail 'grim is required'
  [[ $copy == no ]] || command -v wl-copy >/dev/null || fail 'wl-copy is required to copy'

  local args=()
  case $target in
    monitor:*)
      [[ $target =~ ^monitor:[A-Za-z0-9._:+-]{1,64}$ ]] || fail 'unsafe monitor name'
      args=(-o "${target#monitor:}") ;;
    window:*)
      args=(-T "$(window_handle "${target#window:}")") ;;
    region:*)
      valid_region "${target#region:}" || fail 'region must look like WxH+X+Y'
      args=(-g "$(region_for_grim "${target#region:}")") ;;
    *) fail 'target must be monitor:NAME, window:ADDRESS or region:WxH+X+Y' ;;
  esac

  local file
  if [[ $buffer == yes ]]; then
    mkdir -p -- "${buffer_file%/*}"
    file=$buffer_file
  elif [[ $save == yes ]]; then
    if [[ -z $output ]]; then
      output=${UI_SHELL_SHOT_DIR:-$(user_dir PICTURES Pictures)/screenshots}/screenshot-$(date +%Y%m%d-%H%M%S).png
    fi
    [[ $output == /* && $output =~ ^[A-Za-z0-9._/@+:\ -]+$ && $output != *..* ]] || fail 'unsafe output path'
    mkdir -p -- "${output%/*}"
    file=$output
  else
    temporary=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/ui-shell-shot.XXXXXX")
    trap 'rm -f -- "${temporary-}"' EXIT
    file=$temporary
  fi
  wait_for_layers_gone
  (( delay == 0 )) || sleep "$(awk -v ms="$delay" 'BEGIN { printf "%.3f", ms / 1000 }')"
  grim "${args[@]}" "$file" || fail 'grim could not capture the screen'
  [[ -s $file ]] || fail 'the screenshot is empty'
  if [[ $buffer == yes ]]; then
    jq -cn --arg buffer "$file" --argjson size "$(stat -c %s -- "$file")" '{buffer: $buffer, size: $size}'
    return
  fi
  deliver "$file" "$copy" "$save"
}

# Hand a finished picture to the clipboard and/or report where it is saved.
deliver() {
  local file=$1 copy=$2 save=$3 copied=false
  if [[ $copy == yes ]]; then
    # wl-copy stays alive to serve the clipboard. Left holding the caller's pipes it would keep
    # them open forever, and the caller (the shell reads our output until it closes) would hang.
    wl-copy --type image/png <"$file" >/dev/null 2>&1 || fail 'wl-copy could not copy the image'
    copied=true
  fi
  jq -cn --arg file "$([[ $save == yes ]] && printf '%s' "$file" || true)" --argjson size "$(stat -c %s -- "$file")" --argjson copied "$copied" \
    '{file: (if $file == "" then null else $file end), size: $size, copied: $copied}'
}

# WxH+X+Y (what slurp -f '%wx%h+%x+%y' and the window list give) as grim's "X,Y WxH".
region_for_grim() {
  local value=$1 size offset
  size=${value%%+*}; offset=${value#*+}
  printf '%s,%s %s' "${offset%%+*}" "${offset#*+}" "$size"
}

# Deliver the buffered picture: save it to a file and/or copy it, then drop the buffer.
commit() {
  local copy=yes save=yes output=
  while (( $# )); do
    case $1 in
      --copy) copy=${2-}; shift 2 ;;
      --save) save=${2-}; shift 2 ;;
      --output) output=${2-}; shift 2 ;;
      *) fail "unknown option: $1" ;;
    esac
  done
  [[ $copy == yes || $copy == no ]] || fail '--copy takes yes or no'
  [[ $save == yes || $save == no ]] || fail '--save takes yes or no'
  [[ $copy == yes || $save == yes ]] || fail 'a screenshot needs a destination: copy or save'
  [[ -s $buffer_file ]] || fail 'there is no buffered screenshot'
  [[ $copy == no ]] || command -v wl-copy >/dev/null || fail 'wl-copy is required to copy'
  local file=$buffer_file
  if [[ $save == yes ]]; then
    if [[ -z $output ]]; then
      output=${UI_SHELL_SHOT_DIR:-$(user_dir PICTURES Pictures)/screenshots}/screenshot-$(date +%Y%m%d-%H%M%S).png
    fi
    [[ $output == /* && $output =~ ^[A-Za-z0-9._/@+:\ -]+$ && $output != *..* ]] || fail 'unsafe output path'
    mkdir -p -- "${output%/*}"
    cp -- "$buffer_file" "$output"
    file=$output
  fi
  deliver "$file" "$copy" "$save"
  rm -f -- "$buffer_file"
}

case ${1-} in
  capabilities) capabilities ;;
  capture) shift; capture "$@" ;;
  commit) shift; commit "$@" ;;
  discard) rm -f -- "$buffer_file" ;;
  *) printf '%s\n' 'Usage: screen-shot capabilities|capture TARGET [--copy yes|no] [--save yes|no] [--delay MS] [--output FILE]' >&2; exit 2 ;;
esac
