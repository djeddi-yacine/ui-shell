#!/usr/bin/env bash
set -euo pipefail
[[ $# == 2 ]] || { printf '%s\n' 'Usage: render-audio-settings VOLUME_STEP MAXIMUM_VOLUME' >&2; exit 2; }
case $1 in 1|2|5|10|undefined) ;; *) printf '%s\n' 'volumeStep must be 1, 2, 5, 10, or undefined.' >&2; exit 2;; esac
case $2 in 100|125|150|undefined) ;; *) printf '%s\n' 'maximumVolume must be 100, 125, 150, or undefined.' >&2; exit 2;; esac
printf 'import QtQuick\n\nQtObject {\n    property var volumeStep: %s\n    property var maximumVolume: %s\n}\n' "$1" "$2"
