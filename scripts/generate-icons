#!/usr/bin/env -S python3 -I
"""Convert every shell/svg/*.svg into a themable QML icon in shell/icons/.

    scripts/generate-icons           write shell/icons/*.qml
    scripts/generate-icons --check   exit 1 when a file is missing or out of date

Each SVG is converted by Qt's own `svgtoqml -c` (anti-aliased curve renderer). Only its
ShapePaths are kept, inside a lean Item with a `color` property: the SVG's white becomes
`color`, and a translucent white becomes `color` at that alpha. An SVG that uses any other
colour, or anything but plain shapes, is refused: icons are drawn in white on purpose.
"""
import hashlib
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "shell" / "svg"
OUT = ROOT / "shell" / "icons"
SVGTOQML = "/usr/lib/qt6/bin/svgtoqml"
HEADER = "// Generated by scripts/generate-icons from shell/svg/{src}. Do not edit.\n// source: {digest}\n"


def pascal(name):
    return "".join(part.capitalize() for part in name.split("-"))


def colour(token, src):
    """A svgtoqml colour literal -> a QML expression in terms of root.color."""
    m = re.fullmatch(r'"#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})"', token) or None
    if token in ('"transparent"', '"#00000000"'):
        return '"transparent"'
    if not m or m.group(2, 3, 4) != ("ff", "ff", "ff"):
        sys.exit(f"{src}: colour {token} is not white; recolour the SVG to #ffffff")
    alpha = int(m.group(1), 16)
    return "root.color" if alpha == 255 else f"Qt.alpha(root.color, {alpha / 255:.2f})"


def digest(svg):
    """Identifies the SVG and this script: unchanged inputs skip the slow conversion."""
    return hashlib.sha256(svg.read_bytes() + Path(__file__).read_bytes()).hexdigest()[:16]


def convert(svg):
    with tempfile.TemporaryDirectory() as tmp:
        out = Path(tmp) / "icon.qml"
        subprocess.run([SVGTOQML, "-c", str(svg), str(out)], check=True, capture_output=True)
        text = out.read_text()
    view = re.search(r"Scale \{ xScale: width / ([\d.]+); yScale: height / ([\d.]+) \}", text)
    if not view:
        sys.exit(f"{svg.name}: no viewBox scale in the converted output")
    vw, vh = view.groups()
    paths = re.findall(r"^ {8}ShapePath \{.*?^ {8}\}\n", text, re.S | re.M)
    if not paths or re.search(r"Gradient|\bImage \{|\bText \{|ShaderEffect|\bItem \{", text.split("id: __qt_toplevel", 1)[-1]):
        sys.exit(f"{svg.name}: only plain shapes are supported")
    body = []
    for block in paths:
        block = re.sub(r"^ {12}id: .*\n", "", block, flags=re.M)
        block = re.sub(r"(strokeColor|fillColor): (\"[^\"]*\")",
                       lambda m: f"{m.group(1)}: {colour(m.group(2), svg.name)}", block)
        body.append(block.replace("\n        ", "\n    ").replace("        ShapePath", "    ShapePath", 1))
    return (HEADER.format(src=svg.name, digest=digest(svg)) + "import QtQuick\nimport QtQuick.Shapes\n\n"
            "// The picture is drawn in its viewBox and scaled to the item's size.\n"
            "Item {\n    id: root\n    property color color: \"white\"\n"
            f"    implicitWidth: {vw}\n    implicitHeight: {vh}\n"
            "    Shape {\n        preferredRendererType: Shape.CurveRenderer\n"
            "        transformOrigin: Item.TopLeft\n"
            f"        transform: Scale {{ xScale: root.width / {vw}; yScale: root.height / {vh} }}\n"
            + "".join("\n".join(("    " + l if l else l) for l in b.split("\n")) for b in body)
            + "    }\n}\n")


def current(svg):
    out = OUT / (pascal(svg.stem) + ".qml")
    return out.is_file() and f"// source: {digest(svg)}\n" in out.read_text().split("import", 1)[0]


def main():
    check = "--check" in sys.argv[1:]
    svgs = sorted(SRC.glob("*.svg"))
    names = {pascal(s.stem) + ".qml" for s in svgs}
    stale = [s for s in svgs if not current(s)]
    extra = [p for p in OUT.glob("*.qml") if p.name not in names]
    if check:
        if stale or extra:
            sys.exit("icons out of date (run scripts/generate-icons): " + ", ".join([s.name for s in stale] + [p.name for p in extra]))
        return
    OUT.mkdir(exist_ok=True)
    for p in extra:
        p.unlink()
    for s in stale:
        (OUT / (pascal(s.stem) + ".qml")).write_text(convert(s))
    print(f"{len(svgs)} icons ({len(stale)} regenerated) -> {OUT.relative_to(ROOT)}")


main()
