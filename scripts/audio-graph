#!/usr/bin/env bash
# PipeWire control actions and a normalised graph snapshot for the audio module.
# No daemon: every call reads the live graph (pw-dump) or performs one action.
#
#   audio-graph snapshot [PW_DUMP_JSON]      normalised graph as JSON (a file is a fixture)
#   audio-graph volume NODE_ID PERCENT       0-150, as users see it (PipeWire stores it cubed)
#   audio-graph mute NODE_ID on|off|toggle
#   audio-graph default NODE_ID              make a sink or source the default
#   audio-graph move STREAM_ID TARGET_NODE_NAME|default   route one stream to a device
#   audio-graph link|unlink OUT_PORT_ID IN_PORT_ID
#   audio-graph connect|disconnect OUT_NODE_ID IN_NODE_ID   whole nodes, channels matched (FL-FL, FR-FR)
#   audio-graph pairs OUT_NODE_ID IN_NODE_ID [PW_DUMP_JSON]   the port pairs connect would link
#   audio-graph profile DEVICE_ID PROFILE_INDEX
#
# Every id is a decimal integer and every name is checked before it reaches a tool.
set -euo pipefail

fail() { printf 'audio-graph: %s\n' "$*" >&2; exit 1; }
integer() { [[ ${1-} =~ ^[0-9]{1,9}$ ]] || fail "expected a numeric id, got '${1-}'"; }
need() { command -v "$1" >/dev/null || fail "$1 is required"; }

read -r -d '' program <<'JQ' || true
  # Volume as users see it: the cube root of master volume x mean channel volume.
  def cubic($node):
    ($node.info.params.Props // [] | map(select(has("channelVolumes") or has("volume"))) | .[0]) as $p
    | if $p == null then null
      else ((($p.channelVolumes // []) | if length == 0 then 1 else add / length end) * ($p.volume // 1)) as $linear
        | (if $linear <= 0 then 0 else ($linear | pow(.; 1 / 3)) end | . * 10000 | round / 10000)
      end;
  def muted($node): ($node.info.params.Props // [] | map(select(has("mute"))) | .[0].mute) // false;
  . as $all
  | ([.[] | select(.type == "PipeWire:Interface:Metadata" and .props["metadata.name"] == "default") | .metadata[]?]) as $default
  | ([.[] | select(.type == "PipeWire:Interface:Node")]) as $nodes
  | def defaultName($key): ($default | map(select(.key == $key)) | .[0].value.name) // null;
  def identity($props): ($props["application.id"] // $props["application.process.binary"]
    // $props["application.name"] // $props["node.name"]);
  def device($n): {
    id: $n.id, name: $n.info.props["node.name"],
    label: ($n.info.props["node.description"] // $n.info.props["node.nick"] // $n.info.props["node.name"]),
    volume: cubic($n), muted: muted($n), card: ($n.info.props["device.id"] // null)
  };
  {
    defaults: { sink: defaultName("default.audio.sink"), source: defaultName("default.audio.source") },
    sinks: [$nodes[] | select(.info.props["media.class"] // "" | startswith("Audio/Sink"))
      | device(.) + { default: (.info.props["node.name"] == defaultName("default.audio.sink")) }],
    sources: [$nodes[] | select(.info.props["media.class"] // "" | startswith("Audio/Source"))
      | device(.) + { default: (.info.props["node.name"] == defaultName("default.audio.source")) }],
    streams: [$nodes[] | select(.info.props["media.class"] == "Stream/Output/Audio" or .info.props["media.class"] == "Stream/Input/Audio")
      | . as $s | {
          id: .id,
          kind: (if .info.props["media.class"] == "Stream/Output/Audio" then "playback" else "record" end),
          app: identity(.info.props),
          appName: (.info.props["application.name"] // .info.props["node.name"]),
          label: (.info.props["media.name"] // .info.props["node.description"] // ""),
          volume: cubic(.), muted: muted(.),
          target: ($default | map(select(.subject == $s.id and (.key == "target.object" or .key == "target.node"))) | .[0].value // null)
        }],
    nodes: [$nodes[] | select(.info.props["media.class"] // "" | test("^(Audio/(Sink|Source|Duplex)|Stream/(Output|Input)/Audio)"))
      | { id, name: .info.props["node.name"], class: .info.props["media.class"],
          label: (if (.info.props["media.class"] | startswith("Stream/"))
                  then (.info.props["application.name"] // .info.props["node.name"])
                  else (.info.props["node.description"] // .info.props["node.nick"] // .info.props["node.name"]) end),
          detail: (if (.info.props["media.class"] | startswith("Stream/")) then (.info.props["media.name"] // "") else "" end) }],
    cards: [$all[] | select(.type == "PipeWire:Interface:Device" and (.info.props["media.class"] // "") == "Audio/Device")
      | { id, name: .info.props["device.name"],
          label: (.info.props["device.description"] // .info.props["device.name"]),
          profile: ((.info.params.Profile // [])[0].index // null),
          profiles: [(.info.params.EnumProfile // [])[] | { index, name, description, available }] }],
    ports: [$all[] | select(.type == "PipeWire:Interface:Port")
      | { id, node: .info.props["node.id"], name: .info.props["port.name"], direction: .info.direction,
          channel: (.info.props["audio.channel"] // null),
          audio: ((.info.props["format.dsp"] // "") | test("audio")) }],
    links: [$all[] | select(.type == "PipeWire:Interface:Link")
      | { id, out: .info["output-port-id"], in: .info["input-port-id"],
          outNode: .info["output-node-id"], inNode: .info["input-node-id"] }]
  }
JQ

snapshot() {
  # A file argument, or UI_SHELL_AUDIO_FIXTURE, replaces the live graph (tests, previews).
  local source=${1:-${UI_SHELL_AUDIO_FIXTURE-}}
  if [[ -n $source ]]; then
    [[ -f $source ]] || fail "no such file: $source"
    jq "$program" "$source"
  else
    need pw-dump
    pw-dump | jq "$program"
  fi
}

# Port pairs for linking two nodes: matching channel names (FL-FL, FR-FR), a mono side
# fans out or in, and unnamed ports pair by position.
pairs() {
  snapshot "${3-}" | jq -r --argjson out "$1" --argjson in "$2" '
    def audio($node; $direction): [.ports[] | select(.node == $node and .direction == $direction and .audio)]
      | sort_by(.channel // "", .id);
    audio($out; "output") as $O | audio($in; "input") as $I
    | if ($O | length) == 0 or ($I | length) == 0 then empty
      elif ($O | length) == 1 then $I[] | "\($O[0].id) \(.id)"
      elif ($I | length) == 1 then $O[] | "\(.id) \($I[0].id)"
      else
        [$O[] as $p | $I[] | select(.channel != null and .channel == $p.channel) | "\($p.id) \(.id)"] as $named
        | if ($named | length) > 0 then $named[]
          else range(0; ([$O | length, $I | length] | min)) as $k | "\($O[$k].id) \($I[$k].id)" end
      end'
}

# Links that exist between two nodes, as "outPort inPort" lines.
linked() {
  snapshot | jq -r --argjson out "$1" --argjson in "$2" '.links[] | select(.outNode == $out and .inNode == $in) | "\(.out) \(.in)"'
}

action=${1-}
shift || true
case $action in
  snapshot) snapshot "${1-}" ;;
  volume)
    integer "${1-}"
    [[ ${2-} =~ ^([0-9]|[1-9][0-9]|1[0-4][0-9]|150)$ ]] || fail 'volume must be a whole percent from 0 to 150'
    need wpctl; wpctl set-volume "$1" "$(awk -v p="$2" 'BEGIN { printf "%.2f", p / 100 }')" ;;
  mute)
    integer "${1-}"
    case ${2-} in on) state=1 ;; off) state=0 ;; toggle) state=toggle ;; *) fail 'mute takes on, off or toggle' ;; esac
    need wpctl; wpctl set-mute "$1" "$state" ;;
  default) integer "${1-}"; need wpctl; wpctl set-default "$1" ;;
  move)
    integer "${1-}"
    need pw-metadata
    if [[ ${2-} == default ]]; then
      # Clearing the target makes the stream follow the default device again.
      pw-metadata -n default -d "$1" target.object >/dev/null
      pw-metadata -n default -d "$1" target.node >/dev/null
      # The session manager does not relink a stream whose links were all removed by
      # hand, so "follow the default" must do it from here too.
      sleep 0.5
      follow=$(snapshot | jq -r --argjson id "$1" '
        (.streams[] | select(.id == $id)) as $s
        | (if $s.kind == "playback" then (.defaults.sink as $d | .sinks[] | select(.name == $d))
           else (.defaults.source as $d | .sources[] | select(.name == $d)) end) as $device
        | if ([.links[] | select(.outNode == $id or .inNode == $id)] | length) == 0
          then "\($s.kind) \($device.id)" else empty end') || follow=
      if [[ -n $follow ]]; then
        read -r kind device <<<"$follow"
        if [[ $kind == playback ]]; then "$0" connect "$1" "$device" || true; else "$0" connect "$device" "$1" || true; fi
      fi
    else
      [[ ${2-} =~ ^[A-Za-z0-9._:+@-]{1,200}$ ]] || fail 'unsafe or missing target node name'
      pw-metadata -n default "$1" target.object "$2" Spa:String >/dev/null
    fi ;;
  link) integer "${1-}"; integer "${2-}"; need pw-link; pw-link "$1" "$2" ;;
  unlink) integer "${1-}"; integer "${2-}"; need pw-link; pw-link -d "$1" "$2" ;;
  pairs) integer "${1-}"; integer "${2-}"; pairs "$1" "$2" "${3-}" ;;
  connect)
    integer "${1-}"; integer "${2-}"; need pw-link
    count=0
    while read -r out in; do
      # An existing link is fine: connecting twice is a no-op, not an error.
      pw-link "$out" "$in" 2>/dev/null || true
      count=$((count + 1))
    done < <(pairs "$1" "$2")
    (( count > 0 )) || fail 'these nodes have no matching audio ports' ;;
  disconnect)
    integer "${1-}"; integer "${2-}"; need pw-link
    while read -r out in; do pw-link -d "$out" "$in" 2>/dev/null || true; done < <(linked "$1" "$2") ;;
  profile) integer "${1-}"; integer "${2-}"; need pw-cli
    pw-cli set-param "$1" Profile "{ index: $2 }" >/dev/null ;;
  *) fail 'usage: audio-graph snapshot|volume|mute|default|move|link|unlink|connect|disconnect|pairs|profile ...' ;;
esac
