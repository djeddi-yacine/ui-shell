#!/usr/bin/env bash
# Resolve and validate the installation manifest; emit intermediate data only.
set -euo pipefail
[[ $# == 3 ]] || { printf '%s\n' 'Usage: read-shell-config MANIFEST_INI SETTINGS_INI INI_READER' >&2; exit 2; }
reader=$3
manifest=$(realpath -ms -- "$1")
settings=$(realpath -ms -- "$2")
[[ -f $manifest && -f $settings && -x $reader ]] || { printf '%s\n' 'An existing manifest, settings file and executable INI reader are required.' >&2; exit 2; }
release_root=${manifest%/*}
root=${settings%/*}
home=${HOME:?HOME required}
config_home=${XDG_CONFIG_HOME-$home/.config}
cache_home=${XDG_CACHE_HOME-$home/.cache}
data_home=${XDG_DATA_HOME-$home/.local/share}
state_home=${XDG_STATE_HOME-$home/.local/state}
for base in "$home" "$config_home" "$cache_home" "$data_home" "$state_home"; do
  [[ $base == /* && $base != *$'\n'* && $base != *$'\r'* ]] || { printf '%s\n' 'HOME and XDG roots must be absolute single-line paths.' >&2; exit 2; }
done
resolved=$("$reader" "$manifest" | jq -e --argjson settings "$("$reader" "$settings")" \
  --arg release_root "$release_root" --arg root "$root" --arg manifest "$manifest" --arg settings_file "$settings" \
  --arg home "$home" --arg config "$config_home" --arg cache "$cache_home" --arg data "$data_home" --arg state "$state_home" '
  def exact($expected; $label):
    if keys == ($expected | sort) then . else error("missing/unknown " + $label + " fields") end;
  def path($base):
    if type != "string" or length == 0 or test("[\u0000-\u001f\u007f]") then error("invalid path") else . end
    | if startswith("${HOME}/") then $home + .[7:]
      elif startswith("${XDG_CONFIG_HOME}/") then $config + .[18:]
      elif startswith("${XDG_CACHE_HOME}/") then $cache + .[17:]
      elif startswith("${XDG_DATA_HOME}/") then $data + .[16:]
      elif startswith("${XDG_STATE_HOME}/") then $state + .[17:]
      elif startswith("/") then . else $base + "/" + . end
    | if contains("${") or (ltrimstr("/") | split("/") | any(. == "." or . == ".." or . == "")) then error("unresolved token or unsafe path") else . end;
  exact(["ui_shell", "paths", "user_paths", "bootstrap", "profile_renderers", "commands", "wallpaper_folders"]; "manifest")
  | (.ui_shell | exact(["schema","reads_min","reads_max"]; "ui_shell")) as $header
  | if $header.schema != "3" then error("unsupported manifest schema") else . end
  | if ($header.reads_min | test("^[1-9][0-9]{0,8}$") | not) or ($header.reads_max | test("^[1-9][0-9]{0,8}$") | not)
       or (($header.reads_min | tonumber) > ($header.reads_max | tonumber)) then error("invalid reads range") else . end
  | (.paths | exact(["scripts","shell","quickshell","hypr","profileCache","runtime","shippedThemes","shippedProfiles"]; "paths")) as $paths
  | (.user_paths | exact(["themes","profiles","components","userLua"]; "user_paths")) as $user_paths
  | (.bootstrap | exact(["runtime","wallpaperCatalog","profileModule"]; "bootstrap")) as $bootstrap
  | .profile_renderers as $renderers
  | if ($renderers | type) != "object" or ($renderers | keys | any(test("^[a-z][a-z0-9-]*$") | not)) or
      ($renderers | has("palettes")) or
      ($renderers | has("quickshell") and has("hyprland") and has("hyprpaper") | not) then error("required/invalid profile renderers") else . end
  | (.commands | exact(["readIni","readShellConfig","prepareRuntime","readThemeProfile","readWallpaperSelections","readThemeState","themeCatalog","renderThemeEditor","readThemeEditor","readThemePalette","refreshTheme","saveThemeProfile","activateThemeProfile","selectThemeProfile","publishThemeBundle","compileThemeProfile","renderThemeProfile","renderWallpaperRegistry","renderRuntime","preparePalettes","extractColors","cacheWallpaperColors","renderHyprColors","renderShellColors","renderMonitorPalettes","renderHyprpaper","renderWallpaperCatalog","renderWallpaperTargets","selectWallpaper","renderWallpaperSelection","applyWallpaper","componentSettingsPath","readComponentSettings","saveComponentSettings","renderLauncherSettings","renderPickerSettings","renderControlTuning","audioGraph","renderAudioSettings","screenRecord","screenShot","renderRecordSettings","renderShotSettings","renderMprisSettings","mediaArt","notifySound","clipboard","normalizeCustomColors","normalizeThemeColors","renderThemeColors"]; "commands")) as $commands
  | .wallpaper_folders as $shipped_folders
  # settings.ini holds user choices only: it can neither add nor redefine a shipped address.
  | if ($settings | keys - ["wallpaper_folders", "phantomat"]) != ["theme"] then error("settings.ini may contain only theme, wallpaper_folders and phantomat") else . end
  | ($settings.theme | exact(["profile"]; "theme")) as $theme
  | (if $settings.phantomat then ($settings.phantomat | exact(["library"]; "phantomat")) else {} end) as $phantomat
  | ($settings.wallpaper_folders // {}) as $user_folders
  | if ($shipped_folders | keys) as $shipped | ($user_folders | keys | any(. as $id | $shipped | index($id))) then error("settings.ini redefines a shipped wallpaper folder") else . end
  | ($shipped_folders | to_entries | map({id:.key, path:(.value | path($release_root))}))
    + ($user_folders | to_entries | map({id:.key, path:(.value | path($root))})) as $folders
  | if ($folders | length) == 0 or ($folders | map(.id) | any(test("^[A-Za-z0-9_-]+$") | not)) then error("wallpaper_folders needs named folder IDs") else . end
  | if ($theme.profile | startswith("/") or contains("${")) then error("theme.profile must be settings-root-relative") else . end
  | {schema:1, configFile:$manifest, settingsFile:$settings_file, releaseRoot:$release_root, configRoot:$root,
     xdg:{home:$home, config:$config, cache:$cache, data:$data, state:$state},
     paths:(($paths | with_entries(.value |= path($release_root)))
            + ($user_paths | with_entries(.value |= path($root)))
            + ($phantomat | with_entries(select(.key == "library") | {key:"phantomatLibrary", value:(.value | path($root))}))),
     bootstrap:($bootstrap | with_entries(.value |= path($release_root))),
     profileRenderers:($renderers | with_entries(.value |= path($release_root))),
     commands:($commands | with_entries(.value |= path($release_root))),
     theme:{profile:($theme.profile | path($root))},
     wallpaperFolders:$folders}
  | .runtimeFile = (.paths.runtime + "/config.json")
  | .runtimeLua = (.paths.runtime + "/config.lua")
')
profile_reader=$(jq -er '.commands.readThemeProfile' <<<"$resolved")
profile=$("$profile_reader" "$(jq -er '.theme.profile' <<<"$resolved")" "$root" \
  "$(jq -er '.paths.profiles' <<<"$resolved")" "$(jq -er '.paths.themes' <<<"$resolved")" "$reader" \
  "$(jq -er '.paths.shippedProfiles' <<<"$resolved")" "$(jq -er '.paths.shippedThemes' <<<"$resolved")")
while IFS= read -r definition; do
  [[ -f $definition && ! -L $definition ]] || {
    printf 'Selected Theme definition is missing from configured storage: %s\n' "$definition" >&2; exit 1;
  }
done < <(jq -r '[.theme.definition, (.theme.definitionOverrides | .[])] | .[] | select(length > 0)' <<<"$profile")
jq -e --argjson profile "$profile" '. + $profile' <<<"$resolved"
