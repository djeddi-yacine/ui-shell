#!/usr/bin/env bash
set -euo pipefail

[[ $# == 2 ]] || { printf '%s\n' 'Usage: render-hypr-colors INPUT_JSON OUTPUT_LUA' >&2; exit 2; }
input=$1 output=$2
command -v jq >/dev/null || { printf '%s\n' 'jq is required for Hyprland palette rendering.' >&2; exit 1; }
[[ -f $input ]] || { printf 'Extract colors first: %s\n' "$input" >&2; exit 1; }

temporary=$(mktemp "${output}.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT

jq -er '
  def complete_colors:
    . as $colors | ["accent","selection","muted","background","dark_background","darker_background","lighter_background","foreground","dark_foreground","light_foreground","bright_foreground","red","yellow","orange","green","cyan","blue","magenta","brown","bright_red","bright_yellow","bright_green","bright_cyan","bright_blue","bright_magenta"] | all(.[]; . as $key | $colors | has($key));
  def valid_border:
    . as $value | split(" ") as $parts |
    ($parts[-1] | test("^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)deg$")) as $angled |
    (if $angled then $parts[:-1] else $parts end) as $stops |
    ($stops | length) > 0 and all($stops[]; test("^(rgb\\([0-9A-Fa-f]{6}\\)|rgba\\([0-9A-Fa-f]{8}\\))$")) and
    (($angled | not) or ($stops | length) > 1);
  def border_lua:
    split(" ") as $parts |
    ($parts[-1] | test("^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)deg$")) as $angled |
    (if $angled then $parts[:-1] else $parts end) as $stops |
    if ($stops | length) == 1 and ($angled | not) then $stops[0] | @json
    else "{ colors = { " + ($stops | map(@json) | join(", ")) + " }, angle = " +
      (if $angled then ($parts[-1] | sub("deg$"; "") | tonumber | tostring) else "0" end) + " }"
    end;
  def color($theme; $name): $theme[$name];
  def hypr($theme; $name): "rgb(" + (color($theme; $name) | ltrimstr("#")) + ")";
  . as $theme |
  ["background","surface","surfaceVariant","elevated","text","textMuted","accent","positive","warning","negative","outline","focus","scrim"] as $roles |
  if ($theme | type != "object" or .schema != 2 or (.mode != "dark" and .mode != "light") or
      (keys | sort) != (($roles + ["schema","mode","colors","hyprland"]) | sort)) then error("invalid schema-2 theme") else . end |
  if ([$roles[] as $role | $theme[$role]] | all(type == "string" and test("^#[0-9A-Fa-f]{6}$")) | not) then error("invalid shell role") else . end |
  if ($theme.colors | complete_colors | not) then error("missing named palette slots") else . end |
  if ($theme.colors | type != "object" or length == 0 or
      (to_entries | all(.[]; (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | type == "string" and test("^#[0-9A-Fa-f]{6}$"))) | not)) then error("invalid named colors") else . end |
  if ($theme.hyprland | type != "object" or (keys | sort) != ["active_border","inactive_border"]) then error("invalid Hyprland metadata") else . end |
  if ([ $theme.hyprland.active_border, $theme.hyprland.inactive_border ] | all(type == "string" and valid_border) | not) then error("invalid Hyprland border expression") else . end |
  [
    "-- Generated by scripts/render-hypr-colors. Do not edit.",
    "return {",
    "  mode = " + ($theme.mode | @json) + ",",
    "  background = " + (color($theme; "background") | @json) + ",",
    "  surface = " + (color($theme; "surface") | @json) + ",",
    "  surface_variant = " + (color($theme; "surfaceVariant") | @json) + ",",
    "  elevated = " + (color($theme; "elevated") | @json) + ",",
    "  text = " + (color($theme; "text") | @json) + ",",
    "  text_muted = " + (color($theme; "textMuted") | @json) + ",",
    "  accent = " + (color($theme; "accent") | @json) + ",",
    "  positive = " + (color($theme; "positive") | @json) + ",",
    "  warning = " + (color($theme; "warning") | @json) + ",",
    "  negative = " + (color($theme; "negative") | @json) + ",",
    "  outline = " + (color($theme; "outline") | @json) + ",",
    "  focus = " + (color($theme; "focus") | @json) + ",",
    "  scrim = " + (color($theme; "scrim") | @json) + ",",
    "  colors = {"
  ]
  + ($theme.colors | to_entries | sort_by(.key) | map("    [" + (.key | @json) + "] = " + (.value | @json) + ","))
  + [
    "  },",
    "  hyprland = {",
    "    active_border = " + ($theme.hyprland.active_border | @json) + ",",
    "    inactive_border = " + ($theme.hyprland.inactive_border | @json) + ",",
    "  },",
    "  active_border = " + ($theme.hyprland.active_border | border_lua) + ",",
    "  inactive_border = " + ($theme.hyprland.inactive_border | border_lua) + ",",
    "  group_border_active = " + ($theme.hyprland.active_border | border_lua) + ",",
    "  group_border_inactive = " + ($theme.hyprland.inactive_border | border_lua) + ",",
    "  group_border_locked_active = " + (hypr($theme; "negative") | @json) + ",",
    "  group_border_locked_inactive = " + (hypr($theme; "outline") | @json) + ",",
    "  groupbar_active = " + (hypr($theme; "elevated") | @json) + ",",
    "  groupbar_inactive = " + (hypr($theme; "surface") | @json) + ",",
    "  groupbar_locked_active = " + (hypr($theme; "negative") | @json) + ",",
    "  groupbar_locked_inactive = " + (hypr($theme; "surfaceVariant") | @json) + ",",
    "}", ""
  ] | join("\n")
' "$input" >"$temporary"

mv -f -- "$temporary" "$output"
