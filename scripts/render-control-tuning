#!/usr/bin/env bash
# Renders the control model as QML. The model is DATA in scripts/control-model/:
#   knobs.json     every numeric knob: key, group, label, range, step, default
#   behavior.json  the base behaviour: role vocabulary, flags, state precedence,
#                  emphasis registry and, per family, what each state paints
#   modes.json     named modes: knob presets plus changes over the base behaviour
# This script validates that data, resolves each mode (base merged with its
# changes), and renders QML read by the shell (values, modes) and by the tuning
# popup (schema). To add a knob, a mode, a state role or an emphasis, edit the
# JSON, regenerate the seed and run the tests; no code changes are needed.
#
#   render-control-tuning                      # defaults
#   render-control-tuning mode=wash            # a named preset
#   render-control-tuning mode=wash hoverLayer=0.12 ...  # preset with overrides
#
# Unknown keys, modes, roles and flags, non-numbers and out-of-range values are
# errors. Ranges are bounded so every legal knob combination keeps text readable
# (tests/tst_ControlTuning.qml).
set -euo pipefail

data=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/control-model
for file in knobs behavior modes; do
  [[ -f $data/$file.json ]] || { printf 'render-control-tuning: missing %s/%s.json\n' "$data" "$file" >&2; exit 2; }
done

fail() { printf 'render-control-tuning: %s\n' "${1#jq: error*: }" >&2; exit 2; }

# Resolve every mode: base behaviour merged with the mode's changes, then validated.
modes=$(jq -c --slurpfile base "$data/behavior.json" '
  $base[0] as $base
  | def roles($channel): $base.vocabulary[$channel];
  def check($key; $behavior):
    ( ($behavior.families | to_entries[]) as $family
      | ($family.value.states | to_entries[]) as $state
      | ["fill","fg","border"][] as $channel
      | $state.value[$channel] as $role
      | select((roles($channel) | index($role)) == null)
      | error("\($key).\($family.key).\($state.key): unknown \($channel) role \($role)") ),
    ( $behavior.families | to_entries[] | .key as $name
      | ($behavior.precedence - ($behavior.families[$name].states | keys) | select(length > 0)
        | error("\($key).\($name): precedence names states with no spec: \(join(", "))")) ),
    ( $behavior.flags | to_entries[] | . as $flag
      | select((($base.flagValues[$flag.key] // []) | index($flag.value)) == null)
      | error("\($key): invalid flag \($flag.key)=\($flag.value)") ),
    ( $behavior.emphasis | to_entries[] | . as $emphasis
      | select(($behavior.families[$emphasis.value.family] == null) or ((roles("border") | index($emphasis.value.rest)) == null))
      | error("\($key): emphasis \($emphasis.key) names an unknown family or resting border") );
  map(. as $mode
    | ($base * ($mode.behavior // {})) as $behavior
    | ([check($mode.key; $behavior)] | length) as $checked
    | $mode + {behavior: ($behavior | del(.vocabulary, .flagValues))})
' "$data/modes.json") || fail "$modes"

mode=tonal
overrides='{}'
for argument in "$@"; do
  if [[ $argument == mode=* ]]; then mode=${argument#mode=}; continue; fi
  [[ $argument == *=* ]] || { printf 'Expected key=value, got: %s\n' "$argument" >&2; exit 2; }
  overrides=$(jq -c --arg key "${argument%%=*}" --arg value "${argument#*=}" '. + {($key): $value}' <<<"$overrides")
done

values=$(jq -c --argjson overrides "$overrides" --argjson modes "$modes" --arg mode "$mode" '
  def number($text): try ($text | tonumber) catch error("not a number: \($text)");
  . as $schema
  | ($modes | map(select(.key == $mode)) | first // error("Unknown control tuning mode: \($mode)")) as $preset
  | ($modes | map(.values | keys[]) | unique - ($schema | map(.key))) as $badPreset
  | if ($badPreset | length) > 0 then error("modes name unknown knobs: \($badPreset | join(", "))") else . end
  | ($overrides | keys - ($schema | map(.key))) as $unknown
  | if ($unknown | length) > 0 then error("Unknown control tuning key: \($unknown | join(", "))") else . end
  | reduce $schema[] as $knob ({};
      . + {($knob.key): (
        if $overrides[$knob.key] == null then ($preset.values[$knob.key] // $knob.default)
        else number($overrides[$knob.key]) as $value
          | if $value < $knob.min or $value > $knob.max
            then error("\($knob.key) must be between \($knob.min) and \($knob.max)")
            else $value end
        end)})
' "$data/knobs.json" 2>&1) || fail "$values"

printf '// Generated by scripts/render-control-tuning. Do not edit.\npragma Singleton\nimport QtQuick\n\nQtObject {\n'
printf '    readonly property var schema: %s\n' "$(jq . "$data/knobs.json" | sed '2,$s/^/    /')"
printf '    // The colour roles a behaviour profile may name (ControlColors.roles must provide each).\n'
printf '    readonly property var vocabulary: %s\n' "$(jq -c '.vocabulary' "$data/behavior.json")"
printf '    readonly property string mode: "%s"\n' "$mode"
printf '    readonly property var modes: %s\n' "$(jq . <<<"$modes" | sed '2,$s/^/    /')"
printf '    readonly property var values: (%s)\n' "$values"
printf '}\n'
