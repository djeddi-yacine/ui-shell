#!/usr/bin/env python3
"""List Theme records and palettes by filesystem metadata, never their contents."""
import json
import os
import pathlib
import re
import sys


def records(directory, filename):
    with os.scandir(directory) as entries:
        for entry in entries:
            if entry.name == filename and entry.is_file(follow_symlinks=False):
                yield entry.path


def scan(directory, filename, seen, optional=False):
    """Entries of one store, skipping ids an earlier (user) store already supplied."""
    found = []
    try:
        entries = list(os.scandir(directory))
    except FileNotFoundError:
        if optional:
            return found
        raise
    for entry in entries:
        if entry.name in seen or not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", entry.name) \
                or not entry.is_dir(follow_symlinks=False):
            continue
        for path in records(entry.path, filename):
            seen.add(entry.name)
            found.append({"id": entry.name,
                          "label": " ".join(part[:1].upper() + part[1:] for part in entry.name.split("-")),
                          "path": path})
            break
    return found


def catalog(runtime):
    paths = runtime["paths"]
    # The user store comes first and wins; the shipped store is a read-only second search root.
    saved, palettes, seen_profiles, seen_themes = [], [], set(), set()
    for key in ("profiles", "shippedProfiles"):
        saved += scan(paths[key], "profile.ini", seen_profiles, key.startswith("shipped"))
    for key in ("themes", "shippedThemes"):
        palettes += scan(paths[key], "config.ini", seen_themes, key.startswith("shipped"))
    return {"profiles": sorted(saved, key=lambda item: item["id"]),
            "palettes": sorted(palettes, key=lambda item: item["id"])}


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("Usage: theme-catalog RESOLVED_RUNTIME")
    try:
        with open(sys.argv[1], encoding="utf-8") as source:
            result = catalog(json.load(source))
        print(json.dumps(result, separators=(",", ":")))
    except (OSError, ValueError, KeyError, TypeError) as error:
        sys.exit(f"Could not list Themes: {error}")
