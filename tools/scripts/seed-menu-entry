#!/usr/bin/env bash
# Seed the user's uuctl launcher entry so uuctl asks through the shell's menu (scripts/menu,
# staged under CONFIG_HOME/ui-shell/scripts) instead of the first dmenu-like tool it finds. Only
# when uuctl is installed and the entry is absent: an existing file is the user's and always wins.
# The entry has the same file name as the package's, so it takes precedence over it.
set -euo pipefail
(( $# == 3 )) || { printf '%s\n' 'Usage: seed-menu-entry SOURCE_ROOT CONFIG_HOME DATA_HOME' >&2; exit 2; }
source_root=$(realpath -e -- "$1")
config_home=$(realpath -m -- "$2")
data_home=$(realpath -m -- "$3")
template=$source_root/tools/uuctl.desktop
menu=$config_home/ui-shell/scripts/menu
fail() { printf 'Seed menu entry: %s\n' "$*" >&2; exit 1; }
[[ -f $template && ! -L $template ]] || fail 'tools/uuctl.desktop must be a regular file'
[[ $menu != *[[:space:]]* ]] || fail 'the staged menu path must not contain whitespace (an Exec value would need quoting)'
[[ $menu != *'%'* && $menu != *'\'* && $menu != *'"'* ]] || fail 'the staged menu path must not contain %, \ or "'
[[ ! -L $data_home/applications ]] || fail 'the applications directory must not be a symlink'
command -v uuctl >/dev/null || exit 0
target=$data_home/applications/uuctl.desktop
[[ ! -e $target && ! -L $target ]] || exit 0
mkdir -p -- "$data_home/applications"
temporary=$(mktemp "$data_home/applications/.uuctl.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
while IFS= read -r line || [[ -n $line ]]; do
  printf '%s\n' "${line//@MENU@/$menu}"
done <"$template" >"$temporary"
mv -n -- "$temporary" "$target"
