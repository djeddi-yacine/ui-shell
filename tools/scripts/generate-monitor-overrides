#!/usr/bin/env bash
# Print explicit per-output geometry overrides for the current Hyprland session.
# Development only: output is host-specific. Review and merge it into
# $XDG_CONFIG_HOME/ui-shell/hypr/user/monitors.lua; never commit it as a default.
set -euo pipefail
(( $# <= 1 )) || { printf '%s\n' 'Usage: generate-monitor-overrides [MONITORS_JSON]' >&2; exit 2; }
if (( $# == 1 )); then
  monitors=$(realpath -e -- "$1")
  [[ -f $monitors ]] || { printf 'Monitor data not found: %s\n' "$monitors" >&2; exit 1; }
  data=$(<"$monitors")
else
  command -v hyprctl >/dev/null || { printf '%s\n' 'hyprctl is required without MONITORS_JSON.' >&2; exit 1; }
  data=$(hyprctl -j monitors)
fi
jq -e 'type == "array" and length > 0 and all(.[]; (.name | type == "string" and length > 0)
  and (.width | type == "number") and (.height | type == "number")
  and (.refreshRate | type == "number") and (.x | type == "number")
  and (.y | type == "number") and (.scale | type == "number"))' <<<"$data" >/dev/null ||
  { printf '%s\n' 'Monitor data is incomplete.' >&2; exit 1; }
jq -r '
  "  overrides = {",
  (.[] |
    "    {\n" +
    "      output = \(.name | @json),\n" +
    "      mode = \("\(.width)x\(.height)@\(.refreshRate | tostring)" | @json),\n" +
    "      position = \("\(.x)x\(.y)" | @json),\n" +
    "      scale = \(.scale),\n" +
    "      bitdepth = \(if ((.currentFormat // "") | test("2101010")) then 10 else 8 end),\n" +
    "    },"),
  "  },"
' <<<"$data"
