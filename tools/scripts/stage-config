#!/usr/bin/env bash
# Development deployment only. Install runtime files, never tools/ or tests/.
set -euo pipefail
[[ $# == 2 ]] || { printf '%s\n' 'Usage: stage-config SOURCE_ROOT DESTINATION' >&2; exit 2; }
source_root=$(realpath -- "$1")
destination=$(realpath -m -- "$2")
script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
[[ $destination != "$source_root" && $destination != / ]] || { printf '%s\n' 'Use a separate staging directory.' >&2; exit 2; }
[[ ! -L $destination/hypr ]] ||
  { printf '%s\n' 'Refusing symlinked Hyprland runtime storage.' >&2; exit 2; }
mkdir -p -- "$destination/scripts" "$destination/shell" "$destination/hypr"
cp -a -- "$source_root/scripts/." "$destination/scripts/"
# The sandbox points <source>/shell at the generated tree; it names the shipped QML explicitly.
cp -a -- "${UI_SHELL_STAGE_SHELL:-$source_root/shell}/." "$destination/shell/"
# A staged tree is a development release; the stamp makes the generated cache tree follow it.
printf '%s\n' dev >"$destination/RELEASE"
cp -a -- "$source_root/hypr/." "$destination/hypr/"
# One clean default seed; user-created themes and profiles are never rewritten.
bash "$script_directory/stage-defaults" "$source_root" "$destination"
# The manifest is release-owned and always replaced; settings.ini is user-owned and seeded once.
# Development adds the `project` wallpaper folder (the untracked images in wallpapers/) to the staged copy
# only: a release ships no such folder.
sed 's|^\[wallpaper_folders\]$|&\nproject = wallpapers|' "$source_root/tools/manifest.ini" >"$destination/manifest.ini"
[[ -e $destination/settings.ini ]] || cp -- "$source_root/tools/settings.ini" "$destination/settings.ini"
source_manifest=$("$source_root/scripts/read-ini" "$destination/manifest.ini")
# Validate the installed pair only: the source tree has no runtime stores,
# so a source-root profile resolution is not a valid installation check.
# Absolute/XDG folder choices remain user-owned and are never created or
# rewritten by development staging.
"$source_root/scripts/read-shell-config" "$destination/manifest.ini" "$destination/settings.ini" "$source_root/scripts/read-ini" >/dev/null
while IFS= read -r entry; do
  folder_path=$(jq -er '.value' <<<"$entry")
  [[ $folder_path != /* && $folder_path != '${'* ]] || continue
  [[ -d $source_root/$folder_path ]] || continue
  asset_link=$destination/$folder_path
  [[ -e $asset_link || -L $asset_link ]] && continue
  [[ $(realpath -m -- "$asset_link") == "$destination/"* ]] || { printf '%s\n' 'Asset link must remain inside staging.' >&2; exit 2; }
  mkdir -p -- "${asset_link%/*}"
  ln -s -- "$source_root/$folder_path" "$asset_link"
done < <(jq -c '.wallpaper_folders | to_entries[]' <<<"$source_manifest")
printf '%s\n' "$destination/manifest.ini"
