pragma Singleton
import QtQuick

QtObject {
    readonly property string buttonEmphasis: "outline"
    readonly property string primaryActionEmphasis: "solid"
    readonly property string inputEmphasis: "outline"
    readonly property string selectorEmphasis: "outline"
    readonly property string selectorOptionEmphasis: "flat"
    readonly property string wallpaperTileEmphasis: "outline"
    readonly property string barEntryEmphasis: "flat"
    readonly property int committedMarkerSize: 4

    // Amounts below are read from ControlTuning (generated by scripts/render-control-tuning);
    // only the policy floors and names are declared here.
    readonly property real minimumTextContrast: 4.5
    readonly property real minimumStateContrast: 3.0
    // Body text aims for AAA; it only settles for the 4.5 floor when the hue cannot reach it.
    readonly property real preferredTextContrast: ControlTuning.values.textContrast
    // Secondary text sits below body text but well above the floor.
    readonly property real preferredMutedContrast: ControlTuning.values.mutedContrast
    readonly property real outlineTextMix: ControlTuning.values.outlineTextMix

    readonly property color lightForeground: "#ffffff"
    readonly property color darkForeground: "#000000"
    readonly property color transparentColor: "#00000000"

    // State layers (Material 3): a translucent content-colour wash over the
    // resting fill. The same amounts apply to every emphasis.
    readonly property real hoverLayer: ControlTuning.values.hoverLayer
    readonly property real focusLayer: ControlTuning.values.focusLayer
    readonly property real pressedLayer: ControlTuning.values.pressedLayer
    // Tonal containers: lightness step away from the surface, and how much of the
    // accent's (or status colour's) chroma the container keeps.
    readonly property real containerShift: ControlTuning.values.containerShift
    readonly property real containerChroma: ControlTuning.values.containerChroma
    readonly property real currentShift: ControlTuning.values.currentShift
    readonly property real currentChroma: ControlTuning.values.currentChroma
    // Disabled content and container follow Material's 38% / 12% rule.
    readonly property real disabledContent: ControlTuning.values.disabledContent
    readonly property real disabledContainer: ControlTuning.values.disabledContainer
    // Foreground tint ladder: how far text moves toward the accent encodes
    // engagement. Rest is neutral, hover a hint, pressed/selected strongly accent-hued.
    readonly property real hoverTextMix: ControlTuning.values.hoverTextMix
    readonly property real activeTextMix: ControlTuning.values.activeTextMix
    readonly property real focusMix: ControlTuning.values.focusMix
    readonly property real hoverMix: ControlTuning.values.hoverMix

    function luminance(color) {
        const value = Qt.tint(color, transparentColor)
        function linear(value) {
            return value <= 0.04045 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4)
        }
        return 0.2126 * linear(value.r) + 0.7152 * linear(value.g) + 0.0722 * linear(value.b)
    }

    function mix(base, tint, amount) {
        const value = Qt.tint(tint, transparentColor)
        return Qt.tint(base, Qt.rgba(value.r, value.g, value.b, amount))
    }

    function contrast(first, second) {
        const firstLightness = luminance(first)
        const secondLightness = luminance(second)
        return (Math.max(firstLightness, secondLightness) + 0.05)
            / (Math.min(firstLightness, secondLightness) + 0.05)
    }

    // --- OKLab/OKLCH helpers -------------------------------------------------
    // Contrast fixes shift perceptual lightness and keep hue and chroma, so a
    // corrected colour stays the same colour family instead of fading to grey.
    function toLinear(value) {
        return value <= 0.04045 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4)
    }

    function fromLinear(value) {
        const clamped = Math.min(1, Math.max(0, value))
        return clamped <= 0.0031308 ? clamped * 12.92 : 1.055 * Math.pow(clamped, 1 / 2.4) - 0.055
    }

    function toOklch(color) {
        const value = Qt.tint(color, transparentColor)
        const r = toLinear(value.r), g = toLinear(value.g), b = toLinear(value.b)
        const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
        const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
        const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
        const lightness = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
        const a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
        const bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
        return { l: lightness, c: Math.hypot(a, bb), h: Math.atan2(bb, a) }
    }

    function oklabLinear(lightness, chroma, hue) {
        const a = chroma * Math.cos(hue), b = chroma * Math.sin(hue)
        const l = Math.pow(lightness + 0.3963377774 * a + 0.2158037573 * b, 3)
        const m = Math.pow(lightness - 0.1055613458 * a - 0.0638541728 * b, 3)
        const s = Math.pow(lightness - 0.0894841775 * a - 1.2914855480 * b, 3)
        return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s]
    }

    // Reduces chroma, never lightness or hue, until the colour fits sRGB.
    function fromOklch(lightness, chroma, hue) {
        const clamped = Math.min(1, Math.max(0, lightness))
        function inGamut(value) {
            return oklabLinear(clamped, value, hue).every(channel => channel >= -0.0005 && channel <= 1.0005)
        }
        let used = chroma
        if (!inGamut(used)) {
            let low = 0
            let high = chroma
            for (let step = 0; step < 14; step++) {
                const middle = (low + high) / 2
                if (inGamut(middle)) low = middle
                else high = middle
            }
            used = low
        }
        const rgb = oklabLinear(clamped, used, hue)
        return Qt.rgba(fromLinear(rgb[0]), fromLinear(rgb[1]), fromLinear(rgb[2]), 1)
    }

    // Tonal fill (Material's tone-based container): the base moved a fixed
    // perceptual step toward more contrast, tinted with a low-chroma wash of the
    // hue source. Unlike mixing the hue into the base in sRGB, the result stays
    // clean instead of muddy, at any surface lightness.
    function tonal(base, hueSource, shift, chromaFraction) {
        const origin = toOklch(base)
        const hue = toOklch(hueSource)
        const direction = origin.l < 0.6 ? 1 : -1
        const wanted = Math.min(hue.c * chromaFraction, 0.08)
        // With little or no hue wanted, keep the base's own tint (a plain wash of
        // the surface) instead of dropping to neutral grey.
        return wanted >= origin.c ? fromOklch(origin.l + direction * shift, wanted, hue.h)
            : fromOklch(origin.l + direction * shift, origin.c, origin.h)
    }

    // Perceptual distance (Euclidean in OKLab); about 0.02 is a just-visible step.
    function distance(first, second) {
        const one = toOklch(first), two = toOklch(second)
        return Math.hypot(one.l - two.l, one.c * Math.cos(one.h) - two.c * Math.cos(two.h),
            one.c * Math.sin(one.h) - two.c * Math.sin(two.h))
    }

    // Minimal tonal adjustment, not a replacement theme or recovery state.
    function readable(candidate, background, minimum) {
        return readableOnSurfaces(candidate, [background], minimum)
    }

    function readableOnSurfaces(candidate, backgrounds, minimum) {
        return readableSearch(candidate, backgrounds, minimum, true)
    }

    // Readable at the preferred contrast when the hue allows it, else at the floor.
    function readableText(candidate, backgrounds, target) {
        const aim = Math.max(minimumTextContrast, target === undefined ? preferredTextContrast : target)
        const preferred = readableSearch(candidate, backgrounds, Math.min(aim, 21), false)
        return preferred !== null ? preferred : readableSearch(candidate, backgrounds, minimumTextContrast, true)
    }

    // Smallest OKLCH lightness shift (constant hue and chroma) that reaches `minimum`.
    // Returns null when no tone can, unless `fallback`: then the most readable extreme.
    function readableSearch(candidate, backgrounds, minimum, fallbackAllowed) {
        const color = Qt.tint(candidate, transparentColor)
        if (color.a !== 1 || !backgrounds.length || !Number.isFinite(minimum) || minimum < 1 || minimum > 21)
            throw new Error("Interaction: opaque colors and a contrast floor in [1, 21] are required")
        const surfaces = backgrounds.map(value => Qt.tint(value, transparentColor))
        if (surfaces.some(value => value.a !== 1))
            throw new Error("Interaction: contrast must be measured against opaque surfaces")
        function lowestContrast(value) {
            return Math.min(...surfaces.map(surface => contrast(value, surface)))
        }
        if (lowestContrast(color) >= minimum) return color
        const origin = toOklch(color)
        let result = null
        let smallestShift = Infinity
        let fallback = null
        for (const target of [0, 1]) {
            const end = fromOklch(target, origin.c, origin.h)
            if (fallback === null || lowestContrast(end) > lowestContrast(fallback)) fallback = end
            if (lowestContrast(end) < minimum) continue
            let best = end
            let low = 0
            let high = 1
            for (let step = 0; step < 14; step++) {
                const amount = (low + high) / 2
                const adjusted = fromOklch(origin.l + (target - origin.l) * amount, origin.c, origin.h)
                if (lowestContrast(adjusted) >= minimum) { high = amount; best = adjusted }
                else low = amount
            }
            const shift = high * Math.abs(target - origin.l)
            if (shift < smallestShift) { smallestShift = shift; result = best }
        }
        if (result !== null) return result
        return fallbackAllowed ? fallback : null
    }

    // Text or icon colour for a filled area: near-black or near-white carrying
    // the tint's hue, so content on a coloured fill never turns neutral grey.
    function onFill(fill, tint) {
        const base = Qt.tint(fill, transparentColor)
        const dark = contrast(base, darkForeground) >= contrast(base, lightForeground)
        const hue = toOklch(tint)
        const candidate = fromOklch(dark ? 0.2 : 0.97, Math.min(hue.c, dark ? 0.05 : 0.03), hue.h)
        return readable(candidate, base, minimumTextContrast)
    }

    function foreground(fill) {
        const lightness = luminance(fill)
        return (lightness + 0.05) / 0.05 >= 1.05 / (lightness + 0.05) ? darkForeground : lightForeground
    }
}
