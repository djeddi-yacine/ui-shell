pragma ComponentBehavior: Bound
import QtQuick
import Quickshell.Io
import "../config" as Config

Item {
    id: root
    required property string component
    required property string scope
    required property string outputName
    property string path: ""
    property string revision: ""
    property var values: ({})
    // Control tuning only: the mode the saved file was rendered with.
    property string mode: ""
    property bool ready: false
    property string error: ""
    property bool reading: false
    property bool inspectPending: false
    property bool refreshAgain: false
    signal settled()

    function refresh() {
        if (reading) { refreshAgain = true; return }
        if (!Config.GeneratedRuntime.commands.readComponentSettings) { error = qsTr("The configured settings reader is missing."); settled(); return }
        reading = true
        inspectPending = true
        inspect.command = [Config.GeneratedRuntime.commands.readComponentSettings, component, scope, outputName]
        inspect.running = true
    }
    function finish(message) {
        error = message
        reading = false
        settled()
        if (refreshAgain) { refreshAgain = false; Qt.callLater(refresh) }
    }
    function accept(item) {
        if (component === "controls") {
            // Generated by scripts/render-control-tuning: a flat object of finite numbers.
            const loaded = item.values
            if (loaded === null || typeof loaded !== "object"
                || !Object.values(loaded).every(value => typeof value === "number" && Number.isFinite(value))) {
                finish(qsTr("Invalid control tuning values: %1").arg(path)); return
            }
            values = Object.assign({}, loaded)
            mode = typeof item.mode === "string" ? item.mode : ""
            ready = true
            finish("")
            return
        }
        const options = Config.ComponentSpec.components[component]
        if (!options) { finish(qsTr("Unknown component settings: %1").arg(component)); return }
        if (!options.every(option => Config.ComponentSpec.valid(option, item[option.key]))) {
            finish(qsTr("Invalid QML settings values: %1").arg(path)); return
        }
        const next = {}
        for (const option of options) next[option.key] = item[option.key]
        values = next
        ready = true
        finish("")
    }
    Component.onCompleted: refresh()
    Process {
        id: inspect
        stdout: StdioCollector { id: snapshot }
        stderr: StdioCollector { id: inspectError }
        onExited: function(exitCode, exitStatus) {
            root.inspectPending = false
            if (exitCode !== 0 || exitStatus !== 0) { root.finish(inspectError.text.trim() || qsTr("Could not read component settings.")); return }
            const lines = snapshot.text.trim().split("\n")
            if (lines.length !== 2 || !lines[0].startsWith("/") || !/^(absent|[a-f0-9]{64})$/.test(lines[1])) {
                root.finish(qsTr("Invalid settings revision response.")); return
            }
            root.path = lines[0]
            if (root.ready && root.revision === lines[1] && !root.error) { root.finish(""); return }
            root.revision = lines[1]
            if (root.revision === "absent") {
                qml.source = ""
                root.values = ({})
                root.mode = ""
                root.ready = true
                root.finish("")
                return
            }
            // A revision-qualified native URL avoids reusing a cached QML component.
            qml.source = ""
            qml.source = "file://" + encodeURI(root.path).replace(/#/g, "%23").replace(/\?/g, "%3F")
                + "?revision=" + root.revision
        }
        onRunningChanged: {
            if (!running && root.inspectPending) {
                root.inspectPending = false
                root.finish(qsTr("Could not start settings reader."))
            }
        }
    }
    Loader {
        id: qml
        asynchronous: true
        onLoaded: root.accept(item)
        onStatusChanged: { if (status === Loader.Error) root.finish(qsTr("Could not load QML settings: %1").arg(root.path)) }
    }
}
